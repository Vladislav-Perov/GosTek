<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Каталог шаблонов документов с автообновлением, категоризацией и полнотекстовым поиском
 СОДЕРЖИМОЕ: ContentPage, Grid, ScrollView, Border, Entry, ChipBar, ListRow, AppTabBar, IconView
 ЗАВИСИМОСТИ: GosTek.Views.TemplatesPage, GosTek.Controls.ChipBar, GosTek.Views.AppTabBar, GosTek.Views.ListRow, GosTek.Views.Controls.IconView, GosTek.Views.Controls.LoadingSkeleton
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             xmlns:models="clr-namespace:GosTek.Models"
             xmlns:controls="clr-namespace:GosTek.Controls"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.TemplatesPage"
             Title="Шаблоны"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="{OnPlatform Android=Container, Default=None}">

    <ContentPage.Resources>
        <!-- Строка списка: карточка в стиле дизайн-системы с избранным и векторной иконкой -->
        <DataTemplate x:Key="TemplateRow" x:DataType="models:TemplateItem">
            <views:ListRow Icon="file"
                           Title="{Binding Title}"
                           Subtitle="{Binding Description}"
                           ShowFavorite="True"
                           Tapped="OnTemplateTapped"
                           FavoriteTapped="OnFavoriteTapped" />
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="*">

        <!-- ==================== ОСНОВНОЙ КОНТЕНТ ==================== -->
        <ScrollView Grid.Row="0"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout MaximumWidthRequest="950"
                                 HorizontalOptions="Fill"
                                 Padding="20, 20, 20, 24"
                                 Spacing="16">

                <!-- Заголовок страницы -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Шаблоны"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Label Text="Каталог официальных бланков и студенческих документов по ГОСТ"
                           FontSize="13"
                           TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>

                    <Button x:Name="ImportButton" Grid.Column="1" Text="Добавить DOCX"
                            Clicked="OnImportClicked" VerticalOptions="Center" />
                </Grid>

                <!-- Поисковая строка с векторной иконкой -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16,0"
                        HeightRequest="48">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.06" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Entry x:Name="SearchEntry"
                               Grid.Column="0"
                               Placeholder="Найти шаблон по названию..."
                               PlaceholderColor="{DynamicResource TextSecondary}"
                               TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="Transparent"
                               FontSize="14.5"
                               VerticalOptions="Center"
                               ClearButtonVisibility="WhileEditing"
                               ReturnType="Search"
                               TextChanged="OnSearchChanged" />

                        <!-- Векторная иконка лупы справа через единый IconView -->
                        <vctrl:IconView Grid.Column="1"
                                        Icon="search"
                                        Size="16"
                                        IconColor="TextSecondary"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Фильтр категорий (включая чип ⭐ Избранное) -->
                <controls:ChipBar x:Name="CategoryChips" ShowArrows="True" Margin="0, 2, 0, 2" />

                <!-- Скелетон загрузки каталога (Shimmer Effect) -->
                <vctrl:LoadingSkeleton x:Name="CatalogSkeleton" Margin="0, 4, 0, 8" />

                <!-- Недавние (показываются, когда нет поиска и выбран фильтр «Все») -->
                <VerticalStackLayout x:Name="RecentSection" IsVisible="False" Spacing="10">
                    <Button x:Name="RecentToggle" Text="Показать недавние"
                            Clicked="OnRecentToggleClicked" HorizontalOptions="Start" />

                    <VerticalStackLayout x:Name="RecentList" IsVisible="False"
                                         Spacing="10"
                                         BindableLayout.ItemTemplate="{StaticResource TemplateRow}" />

                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 8, 0, 4" />

                    <Label Text="ВСЕ ШАБЛОНЫ"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="0.8"
                           TextColor="{DynamicResource TextSecondary}"
                           Margin="2, 4, 2, 0" />
                </VerticalStackLayout>

                <!-- Основной список результатов -->
                <VerticalStackLayout x:Name="ResultsList"
                                     Spacing="10"
                                     BindableLayout.ItemTemplate="{StaticResource TemplateRow}" />

                <!-- Состояние: ничего не найдено -->
                <Border x:Name="EmptyCard"
                        IsVisible="False"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="24, 32"
                        Margin="0, 24, 0, 0"
                        HorizontalOptions="Fill">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 24"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Center">
                            <vctrl:IconView Icon="file"
                                            IconColor="BrandGreen"
                                            Size="26"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                        </Border>

                        <Label x:Name="EmptyLabel"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               TextColor="{DynamicResource TextPrimary}" />

                        <Label x:Name="EmptyHint"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
