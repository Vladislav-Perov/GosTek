<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Каталог шаблонов документов с автообновлением, категоризацией, избранным и виртуализированным списком
 СОДЕРЖИМОЕ: ContentPage, Grid, CollectionView, Border, Entry, ChipBar, ListRow, IconView, LoadingSkeleton
 ЗАВИСИМОСТИ: GosTek.Views.TemplatesPage, GosTek.Controls.ChipBar, GosTek.Views.ListRow, GosTek.Views.Controls.IconView, GosTek.Views.Controls.LoadingSkeleton
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             xmlns:models="clr-namespace:GosTek.Models"
             xmlns:controls="clr-namespace:GosTek.Controls"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.TemplatesPage"
             Title="Шаблоны"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="{OnPlatform Android=Container, Default=None}">

    <ContentPage.Resources>
        <!-- Строка списка: карточка в стиле дизайн-системы с избранным и векторной иконкой -->
        <DataTemplate x:Key="TemplateRow" x:DataType="models:TemplateItem">
            <views:ListRow Icon="file"
                           Title="{Binding Title}"
                           Subtitle="{Binding Description}"
                           IsFavorite="{Binding IsFavorite}"
                           HighlightQuery="{Binding HighlightQuery}"
                           ShowFavorite="True"
                           Tapped="OnTemplateTapped"
                           FavoriteTapped="OnFavoriteTapped" />
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="*">

        <!-- ==================== ВИРТУАЛИЗИРОВАННЫЙ КАТАЛОГ ШАБЛОНОВ ==================== -->
        <CollectionView x:Name="ResultsList"
                        Grid.Row="0"
                        ItemSizingStrategy="MeasureFirstItem"
                        SelectionMode="None"
                        MaximumWidthRequest="950"
                        HorizontalOptions="Fill"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <!-- Шапка: заголовок, поиск, категории, недавние (скроллится вместе со списком) -->
            <CollectionView.Header>
                <VerticalStackLayout Spacing="16"
                                     HorizontalOptions="Fill"
                                     Padding="20, 20, 20, 6">

                    <!-- Заголовок страницы -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Шаблоны"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" />
                        <Label Text="Каталог официальных бланков и студенческих документов по ГОСТ"
                               FontSize="15"
                               TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>

                    <!-- Поисковая строка с векторной иконкой лупы -->
                    <Border BackgroundColor="{DynamicResource CardBg}"
                            Stroke="{DynamicResource CardStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16,0"
                            HeightRequest="48">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.06" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Entry x:Name="SearchEntry"
                                   Grid.Column="0"
                                   Placeholder="Найти шаблон по названию..."
                                   PlaceholderColor="{DynamicResource TextSecondary}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="Transparent"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   ClearButtonVisibility="WhileEditing"
                                   ReturnType="Search"
                                   TextChanged="OnSearchChanged" />

                            <!-- Векторная иконка лупы справа через единый IconView -->
                            <vctrl:IconView Grid.Column="1"
                                            Icon="search"
                                            Size="20"
                                            IconColor="TextSecondary"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Фильтр категорий (включая чип «Избранное») -->
                    <controls:ChipBar x:Name="CategoryChips" ShowArrows="True" Margin="0, 2, 0, 2" />

                    <!-- Скелетон загрузки каталога (Shimmer Effect) -->
                    <vctrl:LoadingSkeleton x:Name="CatalogSkeleton" Margin="0, 4, 0, 8" />

                    <!-- Недавние (показываются, когда нет поиска и выбран фильтр «Все») -->
                    <VerticalStackLayout x:Name="RecentSection" IsVisible="False" Spacing="10">
                        <Button x:Name="RecentToggle" Text="Показать недавние"
                                Clicked="OnRecentToggleClicked" HorizontalOptions="Start" />

                        <VerticalStackLayout x:Name="RecentList" IsVisible="False"
                                             Spacing="10"
                                             BindableLayout.ItemTemplate="{StaticResource TemplateRow}" />

                        <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 8, 0, 4" />

                        <Label Text="ВСЕ ШАБЛОНЫ"
                               FontSize="14"
                               FontAttributes="Bold"
                               CharacterSpacing="0.8"
                               TextColor="{DynamicResource TextSecondary}"
                               Margin="2, 4, 2, 0" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Виртуализированный шаблон строки с скомпилированными привязками x:DataType -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TemplateItem">
                    <Grid Padding="20, 0, 20, 0">
                        <views:ListRow Icon="file"
                                       Title="{Binding Title}"
                                       Subtitle="{Binding Description}"
                                       IsFavorite="{Binding IsFavorite}"
                                       HighlightQuery="{Binding HighlightQuery}"
                                       ShowFavorite="True"
                                       Tapped="OnTemplateTapped"
                                       FavoriteTapped="OnFavoriteTapped" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Подвал: карточка «Ничего не найдено» и нижний отступ -->
            <CollectionView.Footer>
                <VerticalStackLayout Padding="{OnPlatform Android='20, 4, 20, 80', WinUI='20, 4, 20, 24'}" HorizontalOptions="Fill">
                    <Border x:Name="EmptyCard"
                            IsVisible="False"
                            BackgroundColor="{DynamicResource CardBg}"
                            Stroke="{DynamicResource CardStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="24, 32"
                            Margin="0, 16, 0, 0"
                            HorizontalOptions="Fill">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 24"
                                    WidthRequest="56"
                                    HeightRequest="56"
                                    HorizontalOptions="Center">
                                <vctrl:IconView Icon="file"
                                                IconColor="BrandGreen"
                                                Size="26"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                            </Border>

                            <Label x:Name="EmptyLabel"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"
                                   TextColor="{DynamicResource TextPrimary}" />

                            <Label x:Name="EmptyHint"
                                   FontSize="15"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"
                                   TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>

    </Grid>
</ContentPage>
