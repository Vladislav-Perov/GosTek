<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             xmlns:models="clr-namespace:GosTek.Models"
             x:Class="GosTek.Views.TemplatesPage"
             Title="Шаблоны"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Строка списка: карточка как «Быстрый старт» на главной -->
        <DataTemplate x:Key="TemplateRow" x:DataType="models:TemplateItem">
            <views:ListRow Icon="📄"
                           Title="{Binding Title}"
                           Subtitle="{Binding Description}"
                           Tapped="OnTemplateTapped" />
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ==================== ШАПКА + ПОИСК + ФИЛЬТРЫ ==================== -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="20, 15, 20, 10"
                             Spacing="14">

            <!-- Заголовок + переключатель темы -->
            <Grid>
                <Label Text="Шаблоны"
                       FontSize="26"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource TextPrimary}" />

                <views:ThemeToggle HorizontalOptions="End" VerticalOptions="Center" />
            </Grid>

            <!-- Поиск -->
            <Border BackgroundColor="{DynamicResource CardBg}"
                    Stroke="{DynamicResource CardStroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,0">
                <Entry x:Name="SearchEntry"
                       Placeholder="Найти шаблон"
                       PlaceholderColor="{DynamicResource TextSecondary}"
                       TextColor="{DynamicResource TextPrimary}"
                       BackgroundColor="Transparent"
                       FontSize="16"
                       HeightRequest="50"
                       ReturnType="Search"
                       TextChanged="OnSearchChanged" />
            </Border>

            <!-- Категории (чипы создаются из кода) -->
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="ChipsHost" Spacing="8" />
            </ScrollView>
        </VerticalStackLayout>

        <!-- ==================== СПИСОК ШАБЛОНОВ ==================== -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout MaximumWidthRequest="700"
                                 HorizontalOptions="Fill"
                                 Padding="24,4,24,20"
                                 Spacing="0">

                <!-- Недавние (показываются, когда нет поиска и фильтра) -->
                <VerticalStackLayout x:Name="RecentSection" IsVisible="False" Spacing="0">
                    <Label Text="Недавние"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           Margin="0,6,0,12" />
                    <VerticalStackLayout x:Name="RecentList" Spacing="12"
                                         BindableLayout.ItemTemplate="{StaticResource TemplateRow}" />
                    <Label Text="Все шаблоны"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           Margin="0,22,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ResultsList" Spacing="12"
                                     BindableLayout.ItemTemplate="{StaticResource TemplateRow}" />

                <Label x:Name="EmptyLabel"
                       Text="Ничего не найдено"
                       IsVisible="False"
                       FontSize="15"
                       HorizontalOptions="Center"
                       Margin="0,40,0,0"
                       TextColor="{DynamicResource TextSecondary}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== ТАББАР ==================== -->
        <views:AppTabBar x:Name="BottomTabs" Grid.Row="2" ActiveTab="templates" />

    </Grid>
</ContentPage>
