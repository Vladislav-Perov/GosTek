<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Главный дашборд приложения с радиальным градиентом, векторными иконками и градиентными кнопками
 СОДЕРЖИМОЕ: MainPage (ContentPage)
 ЗАВИСИМОСТИ: GosTek.Views, GosTek.Models, GosTek.Views.SettingsPanel, GosTek.Views.AppTabBar, GosTek.Resources.Styles.Icons
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             xmlns:models="clr-namespace:GosTek.Models"
             x:Class="GosTek.Views.MainPage"
             Title="Главная"
             Shell.NavBarIsVisible="False">

    <!-- Радиальный фон дизайн-системы для избавления от плоского вида -->
    <Grid RowDefinitions="Auto, *, Auto"
          Background="{DynamicResource MainPageBackgroundBrush}">

        <!-- ==================== ШАПКА ==================== -->
        <Grid Grid.Row="0"
              Padding="20, 16, 20, 8"
              ColumnDefinitions="44, *, 44"
              VerticalOptions="Center"
              MaximumWidthRequest="700"
              HorizontalOptions="Fill">

            <!-- Кнопка «Настройки» (ползунки Sliders в карточке 44x44) -->
            <Border Grid.Column="0"
                    StyleClass="HoverCard"
                    StrokeThickness="1"
                    Stroke="{DynamicResource CardStroke}"
                    BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 14"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    AutomationProperties.Name="Настройки">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsTapped" />
                </Border.GestureRecognizers>
                <Path Data="{StaticResource IconSliders}"
                      Stroke="{DynamicResource TextPrimary}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      WidthRequest="18"
                      HeightRequest="18"
                      Aspect="Uniform"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Border>

            <!-- Логотип GosTek по центру -->
            <Label Grid.Column="1"
                   Text="GosTek"
                   FontSize="30"
                   FontAttributes="Bold"
                   CharacterSpacing="0.5"
                   TextColor="{DynamicResource BrandGreen}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <!-- Переключатель темы справа -->
            <views:ThemeToggle Grid.Column="2"
                               HorizontalOptions="End"
                               VerticalOptions="Center" />
        </Grid>

        <!-- ==================== КОНТЕНТ ==================== -->
        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Never"
                    Padding="20, 8, 20, 24">

            <VerticalStackLayout Spacing="16"
                                 MaximumWidthRequest="660"
                                 HorizontalOptions="Fill">

                <!-- Заголовок-приветствие -->
                <Label x:Name="SubtitleLabel"
                       Text="Что оформим сегодня?"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       HorizontalTextAlignment="Center"
                       Margin="0, 4, 0, 4" />

                <!-- Главная премиальная градиентная карточка «Создать документ» -->
                <Border StyleClass="HoverGreen"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="0"
                        Padding="22, 20"
                        Background="{DynamicResource BrandGreenGradient}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.22" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreateTapped" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16" VerticalOptions="Center">
                        <!-- Текстовая часть слева -->
                        <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="Создать документ"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF" />
                            <Label Text="Выберите шаблон и заполните поля — получите Word или PDF."
                                   FontSize="13.5"
                                   LineHeight="1.35"
                                   TextColor="#E3F3EE"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <!-- Декоративная миниатюра листа документа справа -->
                        <Border Grid.Column="1"
                                WidthRequest="58"
                                HeightRequest="74"
                                StrokeShape="RoundRectangle 6"
                                StrokeThickness="1"
                                Stroke="#CFE5DE"
                                BackgroundColor="#FFFFFF"
                                Padding="8, 10"
                                Rotation="-4"
                                VerticalOptions="Center">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <BoxView HeightRequest="4" WidthRequest="24" HorizontalOptions="Start" Color="{DynamicResource BrandGreen}" CornerRadius="2" />
                                <BoxView HeightRequest="2.5" Color="#CFE5DE" CornerRadius="1" />
                                <BoxView HeightRequest="2.5" Color="#CFE5DE" CornerRadius="1" />
                                <BoxView HeightRequest="2.5" WidthRequest="30" HorizontalOptions="Start" Color="#CFE5DE" CornerRadius="1" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- Две карточки быстрых действий в ряд: «Проверить» и «Сканировать» -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">

                    <!-- Плитка «Проверить» -->
                    <Border Grid.Column="0"
                            StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            Padding="16, 18">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCheckTapped" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="12">
                            <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    HorizontalOptions="Start">
                                <Path Data="{StaticResource IconShield}"
                                      Stroke="{DynamicResource BrandGreen}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Aspect="Uniform"
                                      WidthRequest="20"
                                      HeightRequest="20"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Проверить"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Оформление по ГОСТ"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Плитка «Сканировать» -->
                    <Border Grid.Column="1"
                            StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            Padding="16, 18">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnScanTapped" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="12">
                            <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    HorizontalOptions="Start">
                                <Path Data="{StaticResource IconCamera}"
                                      Stroke="{DynamicResource BrandGreen}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Aspect="Uniform"
                                      WidthRequest="20"
                                      HeightRequest="20"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Сканировать"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Паспорт и текст с фото"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <BoxView x:Name="ProfileDivider" HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" />

                <!-- Карточка профиля со статусом готовности -->
                <Border x:Name="ProfileCard"
                        StyleClass="HoverCard"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="1"
                        Stroke="{DynamicResource CardStroke}"
                        BackgroundColor="{DynamicResource CardBg}"
                        Padding="18, 16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Path Data="{StaticResource IconUser}"
                                  Stroke="{DynamicResource BrandGreen}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Aspect="Uniform"
                                  WidthRequest="16"
                                  HeightRequest="16"
                                  VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Мой профиль"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Label x:Name="ProfilePercentLabel"
                                   Grid.Column="2"
                                   Text="0%"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource AccentGreen}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="3"
                                    BackgroundColor="{DynamicResource IconBoxBg}"
                                    Stroke="{DynamicResource BrandGreen}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8, 3"
                                    VerticalOptions="Center">
                                <Label Text="Настроить"
                                       FontSize="11.5"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandGreen}"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <ProgressBar x:Name="ProfileProgress"
                                     Progress="0"
                                     ProgressColor="{DynamicResource AccentGreen}"
                                     BackgroundColor="{DynamicResource CardStroke}"
                                     HeightRequest="7"
                                     VerticalOptions="Center" />

                        <Label x:Name="ProfileHintLabel"
                               Text=""
                               FontSize="12.5"
                               TextColor="{DynamicResource TextSecondary}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <BoxView x:Name="QuickStartDivider" IsVisible="False" HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" />

                <!-- Секция «Быстрый старт» -->
                <VerticalStackLayout x:Name="QuickStartSection" IsVisible="False" Spacing="10">
                    <Label Text="Быстрый старт"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextSecondary}"
                           Margin="0, 4, 0, 0" />

                    <!-- Первые шаблоны из каталога -->
                    <VerticalStackLayout x:Name="QuickStartList" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TemplateItem">
                                <views:ListRow Icon="file"
                                               Title="{Binding Title}"
                                               Subtitle="{Binding Description}"
                                               Tapped="OnTemplateTapped" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== ТАББАР ==================== -->
        <views:AppTabBar x:Name="BottomTabs" Grid.Row="2" ActiveTab="home" />

        <!-- ==================== ПАНЕЛЬ НАСТРОЕК (поверх всего) ==================== -->
        <views:SettingsPanel x:Name="Settings" Grid.RowSpan="3" />

    </Grid>
</ContentPage>
