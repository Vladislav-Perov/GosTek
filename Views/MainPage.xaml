<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             x:Class="GosTek.Views.MainPage"
             Title="Главная"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>

        <!-- Обычная карточка с эффектом наведения -->
        <Style TargetType="Border" Class="HoverCard">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource CardBg}" />
                                <Setter Property="Stroke" Value="{DynamicResource CardStroke}" />
                                <Setter Property="Scale" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource CardHoverBg}" />
                                <Setter Property="Stroke" Value="{DynamicResource AccentGreen}" />
                                <Setter Property="Scale" Value="1.02" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- Главная зелёная карточка -->
        <Style TargetType="Border" Class="HoverGreen">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#34D399" />
                                <Setter Property="Scale" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#4FE3AF" />
                                <Setter Property="Scale" Value="1.02" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ==================== ШАПКА ==================== -->
        <Grid Grid.Row="0" Padding="20, 15, 12, 10">

            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="5">
                <Label Text="GosTek"
                       FontSize="43"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource BrandGreen}"
                       HorizontalOptions="Center" />
                <Label x:Name="SubtitleLabel"
                       Text="Что оформим сегодня?"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Переключатель темы -->
            <Border StyleClass="HoverCard"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="10,5">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnThemeToggleTapped" />
                </Border.GestureRecognizers>

                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label x:Name="ThemeIcon"
                           Text="🌙"
                           FontSize="16"
                           VerticalOptions="Center" />

                    <Border WidthRequest="40"
                            HeightRequest="22"
                            BackgroundColor="{DynamicResource ToggleTrackBg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 11"
                            VerticalOptions="Center">
                        <Border x:Name="ToggleThumb"
                                WidthRequest="16"
                                HeightRequest="16"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                Margin="3,0,0,0" />
                    </Border>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- ==================== КОНТЕНТ ==================== -->
        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Never"
                    Padding="20, 10, 20, 20">

            <VerticalStackLayout Spacing="20"
                                 MaximumWidthRequest="700"
                                 HorizontalOptions="Center">

                <!-- Главная зелёная карточка -->
                <Border StyleClass="HoverGreen"
                        StrokeShape="RoundRectangle 20"
                        Padding="20"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.15" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStubTapped" CommandParameter="create" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📄" FontSize="24" />
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Создать документ" FontSize="20" FontAttributes="Bold" TextColor="#064E3B" />
                            <Label Text="Выберите шаблон, заполните поля. Файл Word или PDF будет готов."
                                   FontSize="14" TextColor="#065F46" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Две карточки в ряд -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <Border Grid.Column="0" VerticalOptions="Fill"
                            StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 16" Padding="16"
                            StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStubTapped" CommandParameter="check" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Fill">
                            <Label Text="✔️" FontSize="20" />
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Fill">
                                <Label Text="Проверить" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Документ на ошибки оформления" FontSize="12" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" HorizontalOptions="Fill" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" VerticalOptions="Fill"
                            StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 16" Padding="16"
                            StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStubTapped" CommandParameter="scan" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="📷" FontSize="20" />
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Сканировать" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Из фото в данные или текст" FontSize="12" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 4" />

                <!-- Карточка профиля -->
                <Border StyleClass="HoverCard"
                        StrokeShape="RoundRectangle 16" Padding="16"
                        StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Мой профиль 👤" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="ProfilePercentLabel" Text="0%" TextColor="{DynamicResource TextPrimary}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End" />
                            <ProgressBar x:Name="ProfileProgress" Progress="0" ProgressColor="{DynamicResource AccentGreen}" BackgroundColor="{DynamicResource CardStroke}" HeightRequest="12" VerticalOptions="Center" />
                        </VerticalStackLayout>
                        <Label x:Name="ProfileHintLabel" Text="" FontSize="12" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 4" />

                <!-- Быстрый старт -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Быстрый старт" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />

                    <Border StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 16" Padding="14"
                            StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStubTapped" CommandParameter="explanatory" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="{DynamicResource IconBoxBg}" StrokeShape="RoundRectangle 10" WidthRequest="40" HeightRequest="40" StrokeThickness="0" VerticalOptions="Center">
                                <Label Text="📄" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Объяснительная записка" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Причина опоздания, нарушения срока, отсутствия" FontSize="12" TextColor="{DynamicResource TextSecondary}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 16" Padding="14"
                            StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStubTapped" CommandParameter="ip" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="{DynamicResource IconBoxBg}" StrokeShape="RoundRectangle 10" WidthRequest="40" HeightRequest="40" StrokeThickness="0" VerticalOptions="Center">
                                <Label Text="📄" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Заявление о регистрации ИП" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Для подачи в регистрирующий орган" FontSize="12" TextColor="{DynamicResource TextSecondary}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== ТАББАР ==================== -->
        <views:AppTabBar x:Name="BottomTabs" Grid.Row="2" ActiveTab="home" />

    </Grid>
</ContentPage>