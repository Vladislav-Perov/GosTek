<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Главный дашборд приложения, векторными иконками и левым rail на Windows
 СОДЕРЖИМОЕ: MainPage (ContentPage)
 ЗАВИСИМОСТИ: GosTek.Views, GosTek.Models, GosTek.Views.SettingsPanel, GosTek.Views.AppTabBar, GosTek.Views.Controls.IconView
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:GosTek.Models"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.MainPage"
             Title="Главная"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="{OnPlatform Android=Container, Default=None}">

    <Grid BackgroundColor="{DynamicResource PageBg}">

        <!-- ==================== КОНТЕНТ ==================== -->
        <ScrollView
                    VerticalScrollBarVisibility="Never">

            <VerticalStackLayout Spacing="16"
                                 MaximumWidthRequest="1050"
                                 HorizontalOptions="Fill"
                                 Padding="{OnPlatform Android='20, 24, 20, 80', WinUI='36, 32, 36, 24'}">

                <!-- ==================== ШАПКА ==================== -->
                <Grid IsVisible="{OnPlatform Android=True, WinUI=False, Default=False}"
                      Padding="0, 8, 0, 8"
                      ColumnDefinitions="44, *, 44"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill">

                    <!-- Кнопка «Настройки» (только на Android; на Windows настройки размещены в левом rail) -->
                    <Border Grid.Column="0"
                            StyleClass="HoverCard"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            StrokeShape="RoundRectangle 14"
                            WidthRequest="44"
                            HeightRequest="44"
                            Padding="0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Настройки">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped" />
                        </Border.GestureRecognizers>
                        <vctrl:IconView Icon="sliders"
                                        Size="22"
                                        IconColor="TextPrimary"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                    </Border>

                    <!-- Логотип GosTek по центру (только на Android, чтобы не дублировать логотип левого rail Windows) -->
                    <Label Grid.Column="1"
                           Text="GosTek"
                           FontAttributes="Bold"
                           FontSize="28"
                           TextColor="{DynamicResource TextPrimary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Заголовок страницы -->
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Работа с документами"
                           FontSize="{OnPlatform Android=29, Default=38}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Label Text="Шаблоны, проверка по ГОСТ и экспорт"
                           FontSize="15"
                           TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>

                <Border StrokeThickness="0" BackgroundColor="{DynamicResource ActionBg}" StrokeShape="RoundRectangle 8"
                        Padding="22,18">
                    <Grid ColumnDefinitions="{OnPlatform Android='*', Default='*,Auto'}"
                          RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                        <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="Новый документ" FontSize="22" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Выберите шаблон и сохраните готовый файл в Word или PDF."
                                   FontSize="16" TextColor="#E3EDF9" />
                        </VerticalStackLayout>
                        <Button Grid.Column="{OnPlatform Android=0, Default=1}" Grid.Row="{OnPlatform Android=1, Default=0}"
                                Text="+  Создать документ" Clicked="OnCreateClicked" FontSize="16"
                                HorizontalOptions="Start" VerticalOptions="Center"
                                BackgroundColor="White" TextColor="{DynamicResource ActionBg}"
                                CornerRadius="8" FontAttributes="Bold" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="{OnPlatform Android='*', Default='*,*,*,*'}"
                      RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Grid.Column="0" StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 6" StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}" BackgroundColor="{DynamicResource CardBg}"
                            Padding="10, 12" MinimumHeightRequest="56">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTemplatesTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <vctrl:IconView Icon="folder" IconColor="TextSecondary" Size="24" />
                            <Label Grid.Column="1" Text="Шаблоны" FontSize="17" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="{OnPlatform Android=0, Default=1}" Grid.Row="{OnPlatform Android=1, Default=0}" StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 6" StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}" BackgroundColor="{DynamicResource CardBg}"
                            Padding="10, 12" MinimumHeightRequest="56">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCheckTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <vctrl:IconView Icon="shield" IconColor="TextSecondary" Size="24" />
                            <Label Grid.Column="1" Text="Проверка по ГОСТ" FontSize="17" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="{OnPlatform Android=2, Default=0}" Grid.Column="{OnPlatform Android=0, Default=2}" StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 6" StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}" BackgroundColor="{DynamicResource CardBg}"
                            Padding="10, 12" MinimumHeightRequest="56">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnScanTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <vctrl:IconView Icon="camera" IconColor="TextSecondary" Size="24" />
                            <Label Grid.Column="1" Text="{OnPlatform Android=Сканирование, Default='Оцифровать фото'}" FontSize="17" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="3" IsVisible="{OnPlatform WinUI=True, Default=False}" StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 6" StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}" BackgroundColor="{DynamicResource CardBg}"
                            Padding="10, 12" MinimumHeightRequest="56">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <vctrl:IconView Icon="user" IconColor="TextSecondary" Size="24" />
                            <Label Grid.Column="1" Text="Мой профиль" FontSize="17" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Секция «Быстрый старт» -->
                <Border x:Name="QuickStartSection" IsVisible="False" Stroke="{DynamicResource CardStroke}"
                        BackgroundColor="{DynamicResource CardBg}" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout>
                        <Label Text="Быстрый доступ" Margin="16,13" FontSize="18"
                               FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                        <VerticalStackLayout x:Name="QuickStartList">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:TemplateItem">
                                    <VerticalStackLayout>
                                        <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />
                                        <Border Padding="16,10" StrokeThickness="0" StyleClass="HoverCard">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTemplateTapped" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <vctrl:IconView Icon="file" Size="24" IconColor="TextSecondary" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold"
                                                           TextColor="{DynamicResource TextPrimary}" />
                                                    <Label Text="{Binding Description}" FontSize="15"
                                                           TextColor="{DynamicResource TextSecondary}" />
                                                </VerticalStackLayout>
                                                <vctrl:IconView Grid.Column="2" Icon="chevronright" Size="20" IconColor="TextSecondary" />
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <BoxView x:Name="ProfileDivider" HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" HorizontalOptions="Fill" />

                <!-- Карточка профиля со статусом готовности -->
                <Border x:Name="ProfileCard"
                        StyleClass="HoverCard"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1"
                        Stroke="{DynamicResource CardStroke}"
                        BackgroundColor="{DynamicResource CardBg}"
                        HorizontalOptions="Fill"
                        Padding="18, 16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <vctrl:IconView Icon="user"
                                            IconColor="BrandGreen"
                                            Size="20"
                                            VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Мой профиль"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Label x:Name="ProfilePercentLabel"
                                   Grid.Column="2"
                                   Text="0%"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource AccentGreen}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="3"
                                    BackgroundColor="{DynamicResource IconBoxBg}"
                                    Stroke="{DynamicResource BrandGreen}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8, 3"
                                    VerticalOptions="Center">
                                <Label Text="Настроить"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <ProgressBar x:Name="ProfileProgress"
                                     Progress="0"
                                     ProgressColor="{DynamicResource AccentGreen}"
                                     BackgroundColor="{DynamicResource CardStroke}"
                                     HeightRequest="7"
                                     VerticalOptions="Center" />

                        <Label x:Name="ProfileHintLabel"
                               Text=""
                               FontSize="14"
                               TextColor="{DynamicResource TextSecondary}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>



            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
