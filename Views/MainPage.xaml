<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Главный дашборд приложения, векторными иконками и левым rail на Windows
 СОДЕРЖИМОЕ: MainPage (ContentPage)
 ЗАВИСИМОСТИ: GosTek.Views, GosTek.Models, GosTek.Views.SettingsPanel, GosTek.Views.AppTabBar, GosTek.Views.Controls.IconView
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             xmlns:models="clr-namespace:GosTek.Models"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.MainPage"
             Title="Главная"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="{OnPlatform Android=Container, Default=None}">

    <Grid RowDefinitions="*"
          BackgroundColor="{DynamicResource PageBg}">

        <!-- ==================== КОНТЕНТ ==================== -->
        <ScrollView Grid.Row="0"
                    VerticalScrollBarVisibility="Never">

            <VerticalStackLayout Spacing="16"
                                 MaximumWidthRequest="950"
                                 HorizontalOptions="Fill"
                                 Padding="{OnPlatform Android='20, 24, 20, 80', WinUI='20, 20, 20, 24'}">

                <!-- ==================== ШАПКА ==================== -->
                <Grid IsVisible="{OnPlatform Android=True, WinUI=False, Default=False}"
                      Padding="0, 8, 0, 8"
                      ColumnDefinitions="44, *, 44"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill">

                    <!-- Кнопка «Настройки» (только на Android; на Windows настройки размещены в левом rail) -->
                    <Border Grid.Column="0"
                            StyleClass="HoverCard"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            StrokeShape="RoundRectangle 14"
                            WidthRequest="44"
                            HeightRequest="44"
                            Padding="0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Настройки">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped" />
                        </Border.GestureRecognizers>
                        <vctrl:IconView Icon="sliders"
                                        Size="18"
                                        IconColor="TextPrimary"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                    </Border>

                    <!-- Логотип GosTek по центру (только на Android, чтобы не дублировать логотип левого rail Windows) -->
                    <Label Grid.Column="1"
                           Text="GosTek"
                           FontAttributes="Bold"
                           FontSize="28"
                           TextColor="{DynamicResource TextPrimary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Заголовок страницы -->
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Работа с документами"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Label Text="Шаблоны, проверка по ГОСТ и экспорт"
                           FontSize="13"
                           TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>

                <Border BackgroundColor="{DynamicResource ActionBg}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 8"
                        Padding="22, 20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Новый документ"
                               FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Выберите шаблон, заполните поля и сохраните документ в Word или PDF."
                               FontSize="14" TextColor="White" />
                        <Button Text="Создать документ" Clicked="OnCreateClicked"
                                HorizontalOptions="Start" Margin="0,4,0,0"
                                BackgroundColor="White" TextColor="{DynamicResource ActionBg}"
                                CornerRadius="5" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- Карточки быстрых действий: на Android две в ряд («Проверить» и «Сканировать»), на Windows одна широкая («Проверить») -->
                <Grid ColumnDefinitions="{OnPlatform Android='*, *', WinUI='*', Default='*'}" ColumnSpacing="16" HorizontalOptions="Fill">

                    <!-- Плитка «Проверить» -->
                    <Border Grid.Column="0"
                            StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            HorizontalOptions="Fill"
                            Padding="12, 14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCheckTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <vctrl:IconView Icon="shield" IconColor="TextSecondary" Size="20" />

                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Проверить"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Оформление по ГОСТ"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Плитка «Сканировать» (только на мобильных устройствах Android) -->
                    <Border Grid.Column="1"
                            IsVisible="{OnPlatform Android=True, WinUI=False, Default=False}"
                            StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            HorizontalOptions="Fill"
                            Padding="12, 14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnScanTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <vctrl:IconView Icon="camera" IconColor="TextSecondary" Size="20" />

                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Сканировать"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Паспорт и текст с фото"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <BoxView x:Name="ProfileDivider" HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" HorizontalOptions="Fill" />

                <!-- Карточка профиля со статусом готовности -->
                <Border x:Name="ProfileCard"
                        StyleClass="HoverCard"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1"
                        Stroke="{DynamicResource CardStroke}"
                        BackgroundColor="{DynamicResource CardBg}"
                        HorizontalOptions="Fill"
                        Padding="18, 16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <vctrl:IconView Icon="user"
                                            IconColor="BrandGreen"
                                            Size="16"
                                            VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Мой профиль"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Label x:Name="ProfilePercentLabel"
                                   Grid.Column="2"
                                   Text="0%"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource AccentGreen}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="3"
                                    BackgroundColor="{DynamicResource IconBoxBg}"
                                    Stroke="{DynamicResource BrandGreen}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8, 3"
                                    VerticalOptions="Center">
                                <Label Text="Настроить"
                                       FontSize="11.5"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <ProgressBar x:Name="ProfileProgress"
                                     Progress="0"
                                     ProgressColor="{DynamicResource AccentGreen}"
                                     BackgroundColor="{DynamicResource CardStroke}"
                                     HeightRequest="7"
                                     VerticalOptions="Center" />

                        <Label x:Name="ProfileHintLabel"
                               Text=""
                               FontSize="12.5"
                               TextColor="{DynamicResource TextSecondary}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <BoxView x:Name="QuickStartDivider" IsVisible="False" HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" HorizontalOptions="Fill" />

                <!-- Секция «Быстрый старт» -->
                <VerticalStackLayout x:Name="QuickStartSection" IsVisible="False" Spacing="10" HorizontalOptions="Fill">
                    <Label Text="Быстрый старт"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextSecondary}"
                           Margin="0, 4, 0, 0" />

                    <!-- Первые три шаблона из каталога в виде компактных плашек -->
                    <VerticalStackLayout x:Name="QuickStartList" Spacing="10" HorizontalOptions="Fill">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TemplateItem">
                                <views:ListRow Icon="file"
                                               Title="{Binding Title}"
                                               Subtitle="{Binding Description}"
                                               Details="{Binding LastModified}"
                                               Tapped="OnTemplateTapped" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
