<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Главный дашборд приложения с радиальным градиентом, векторными иконками и левым rail на Windows
 СОДЕРЖИМОЕ: MainPage (ContentPage)
 ЗАВИСИМОСТИ: GosTek.Views, GosTek.Models, GosTek.Views.SettingsPanel, GosTek.Views.AppTabBar, GosTek.Views.Controls.IconView
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             xmlns:models="clr-namespace:GosTek.Models"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.MainPage"
             Title="Главная"
             Shell.NavBarIsVisible="False">

    <!-- Радиальный фон дизайн-системы для избавления от плоского вида -->
    <Grid ColumnDefinitions="{OnPlatform Android='*', WinUI='220, *'}"
          RowDefinitions="{OnPlatform Android='Auto, *, Auto', WinUI='Auto, *, 0'}"
          Background="{DynamicResource MainPageBackgroundBrush}">

        <!-- ==================== ШАПКА ==================== -->
        <Grid Grid.Row="0"
              Grid.Column="{OnPlatform Android=0, WinUI=1}"
              Padding="20, 16, 20, 8"
              ColumnDefinitions="{OnPlatform Android='44, *, 44', WinUI='*'}"
              VerticalOptions="Center"
              MaximumWidthRequest="700"
              HorizontalOptions="Fill">

            <!-- Кнопка «Настройки» (только на Android; на Windows настройки размещены в левом rail) -->
            <Border Grid.Column="0"
                    IsVisible="{OnPlatform Android=True, WinUI=False, Default=False}"
                    StyleClass="HoverCard"
                    StrokeThickness="1"
                    Stroke="{DynamicResource CardStroke}"
                    BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 14"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    AutomationProperties.Name="Настройки">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsTapped" />
                </Border.GestureRecognizers>
                <vctrl:IconView Icon="sliders"
                                Size="18"
                                IconColor="TextPrimary"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
            </Border>

            <!-- Логотип GosTek по центру -->
            <Label Grid.Column="{OnPlatform Android=1, WinUI=0}"
                   Text="GosTek"
                   FontSize="30"
                   FontAttributes="Bold"
                   CharacterSpacing="0.5"
                   TextColor="{DynamicResource BrandGreen}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <!-- Переключатель темы справа (только на Android; на Windows — в левом rail) -->
            <views:ThemeToggle Grid.Column="2"
                               IsVisible="{OnPlatform Android=True, WinUI=False, Default=False}"
                               HorizontalOptions="End"
                               VerticalOptions="Center" />
        </Grid>

        <!-- ==================== КОНТЕНТ ==================== -->
        <ScrollView Grid.Row="1"
                    Grid.Column="{OnPlatform Android=0, WinUI=1}"
                    VerticalScrollBarVisibility="Never"
                    Padding="{OnPlatform Android='20, 8, 20, 80', WinUI='20, 8, 20, 24'}">

            <VerticalStackLayout Spacing="16"
                                 MaximumWidthRequest="660"
                                 HorizontalOptions="Fill">

                <!-- Заголовок-приветствие -->
                <Label x:Name="SubtitleLabel"
                       Text="Что оформим сегодня?"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       HorizontalTextAlignment="Center"
                       Margin="0, 4, 0, 4" />

                <!-- Главная премиальная градиентная карточка «Создать документ» -->
                <Border StyleClass="HoverGreen"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="0"
                        Padding="22, 20"
                        Background="{DynamicResource BrandGreenGradient}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.22" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreateTapped" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16" VerticalOptions="Center">
                        <!-- Текстовая часть слева -->
                        <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="Создать документ"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF" />
                            <Label Text="Выберите шаблон и заполните поля — получите Word или PDF."
                                   FontSize="13.5"
                                   LineHeight="1.35"
                                   TextColor="#E3F3EE"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <!-- Декоративная миниатюра листа документа справа -->
                        <Border Grid.Column="1"
                                WidthRequest="58"
                                HeightRequest="74"
                                StrokeShape="RoundRectangle 6"
                                StrokeThickness="1"
                                Stroke="#CFE5DE"
                                BackgroundColor="#FFFFFF"
                                Padding="8, 10"
                                Rotation="-4"
                                VerticalOptions="Center">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <BoxView HeightRequest="4" WidthRequest="24" HorizontalOptions="Start" Color="{DynamicResource BrandGreen}" CornerRadius="2" />
                                <BoxView HeightRequest="2.5" Color="#CFE5DE" CornerRadius="1" />
                                <BoxView HeightRequest="2.5" Color="#CFE5DE" CornerRadius="1" />
                                <BoxView HeightRequest="2.5" WidthRequest="30" HorizontalOptions="Start" Color="#CFE5DE" CornerRadius="1" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- Две карточки быстрых действий в ряд: «Проверить» и «Сканировать» -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">

                    <!-- Плитка «Проверить» -->
                    <Border x:Name="CheckCard"
                            Grid.Column="0"
                            StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1.5"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            Padding="16, 18">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCheckTapped" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="12">
                            <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    HorizontalOptions="Start">
                                <vctrl:IconView Icon="shield"
                                                IconColor="BrandGreen"
                                                Size="20"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Проверить"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Оформление по ГОСТ"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Плитка «Сканировать» -->
                    <Border x:Name="ScanCard"
                            Grid.Column="1"
                            StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1.5"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            Padding="16, 18">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnScanTapped" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="12">
                            <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    HorizontalOptions="Start">
                                <vctrl:IconView Icon="camera"
                                                IconColor="BrandGreen"
                                                Size="20"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Сканировать"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Паспорт и текст с фото"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <BoxView x:Name="ProfileDivider" HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" />

                <!-- Карточка профиля со статусом готовности -->
                <Border x:Name="ProfileCard"
                        StyleClass="HoverCard"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="1"
                        Stroke="{DynamicResource CardStroke}"
                        BackgroundColor="{DynamicResource CardBg}"
                        Padding="18, 16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <vctrl:IconView Icon="user"
                                            IconColor="BrandGreen"
                                            Size="16"
                                            VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Мой профиль"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Label x:Name="ProfilePercentLabel"
                                   Grid.Column="2"
                                   Text="0%"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource AccentGreen}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="3"
                                    BackgroundColor="{DynamicResource IconBoxBg}"
                                    Stroke="{DynamicResource BrandGreen}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8, 3"
                                    VerticalOptions="Center">
                                <Label Text="Настроить"
                                       FontSize="11.5"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandGreen}"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <ProgressBar x:Name="ProfileProgress"
                                     Progress="0"
                                     ProgressColor="{DynamicResource AccentGreen}"
                                     BackgroundColor="{DynamicResource CardStroke}"
                                     HeightRequest="7"
                                     VerticalOptions="Center" />

                        <Label x:Name="ProfileHintLabel"
                               Text=""
                               FontSize="12.5"
                               TextColor="{DynamicResource TextSecondary}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <BoxView x:Name="QuickStartDivider" IsVisible="False" HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" />

                <!-- Секция «Быстрый старт» -->
                <VerticalStackLayout x:Name="QuickStartSection" IsVisible="False" Spacing="10">
                    <Label Text="Быстрый старт"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextSecondary}"
                           Margin="0, 4, 0, 0" />

                    <!-- Первые шаблоны из каталога -->
                    <VerticalStackLayout x:Name="QuickStartList" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TemplateItem">
                                <views:ListRow Icon="file"
                                               Title="{Binding Title}"
                                               Subtitle="{Binding Description}"
                                               Details="{Binding LastModified}"
                                               Tapped="OnTemplateTapped" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== ТАББАР (на Windows — левый rail, на Android — нижний) ==================== -->
        <views:AppTabBar x:Name="BottomTabs"
                         Grid.Row="{OnPlatform Android=2, WinUI=0}"
                         Grid.RowSpan="{OnPlatform Android=1, WinUI=3}"
                         Grid.Column="0"
                         ActiveTab="home" />

        <!-- ==================== ПАНЕЛЬ НАСТРОЕК (поверх всего) ==================== -->
        <views:SettingsPanel x:Name="Settings"
                             Grid.RowSpan="3"
                             Grid.ColumnSpan="{OnPlatform Android=1, WinUI=2}" />

    </Grid>
</ContentPage>
