<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Интерфейс боковой шторки настроек приложения (выбор папки, темы, приватность, очистка)
 СОДЕРЖИМОЕ: ContentView, Grid, Border, Label, ScrollView, IconView
 ЗАВИСИМОСТИ: GosTek.Views.SettingsPanel, GosTek.SettingsService, GosTek.ThemeService, GosTek.Views.Controls.IconView
 ==============================================================================
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.SettingsPanel"
             InputTransparent="False"
             CascadeInputTransparent="False"
             IsVisible="False">

    <!-- Затемнение подложки и выезжающая боковая панель -->
    <Grid InputTransparent="False"
          CascadeInputTransparent="False">

        <!-- Затемняющий экран с перехватом клика для закрытия (Black с динамическим Opacity для корректного рендера на Android) -->
        <BoxView x:Name="Scrim"
                 ZIndex="1"
                 Color="Black"
                 Opacity="0"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Выезжающая панель Side Drawer слева -->
        <Border x:Name="Panel"
                ZIndex="100"
                InputTransparent="False"
                HorizontalOptions="Start"
                WidthRequest="{OnPlatform WinUI=360}"
                MaximumWidthRequest="360"
                Margin="{OnPlatform Android='0,0,48,0', WinUI=0}"
                BackgroundColor="{DynamicResource PageBg}"
                Stroke="{DynamicResource CardStroke}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 0, 24, 24, 0"
                Padding="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="6, 0" Radius="24" Opacity="0.3" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto, *"
                  InputTransparent="False"
                  CascadeInputTransparent="False">

                <!-- ===== ШАПКА ПАНЕЛИ НАСТРОЕК ===== -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="12"
                      Padding="{OnPlatform Android='20, 28, 16, 12', WinUI='20, 18, 16, 12'}"
                      BackgroundColor="{DynamicResource PageBg}"
                      InputTransparent="False"
                      CascadeInputTransparent="False">

                    <Border BackgroundColor="{DynamicResource IconBoxBg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="36"
                            HeightRequest="36"
                            InputTransparent="True"
                            VerticalOptions="Center">
                        <vctrl:IconView Icon="sliders"
                                        IconColor="BrandGreen"
                                        Size="18"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        InputTransparent="True" />
                    </Border>

                    <Label Grid.Column="1"
                           Text="Настройки"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           InputTransparent="True"
                           VerticalOptions="Center" />

                    <Border Grid.Column="2"
                            StyleClass="HoverCard"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            StrokeShape="RoundRectangle 12"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"
                            InputTransparent="False"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="✕"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Border>
                </Grid>

                <!-- ===== ПРОКРУЧИВАЕМЫЙ СПИСОК РАЗДЕЛОВ ===== -->
                <ScrollView Grid.Row="1"
                            VerticalScrollBarVisibility="Never"
                            InputTransparent="False"
                            CascadeInputTransparent="False">
                    <VerticalStackLayout Padding="20, 6, 20, 24"
                                         Spacing="20"
                                         InputTransparent="False"
                                         CascadeInputTransparent="False">

                        <!-- ===== РАЗДЕЛ: ШАБЛОНЫ ===== -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="ШАБЛОНЫ ДОКУМЕНТОВ"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.8"
                                   TextColor="{DynamicResource BrandGreen}" />

                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="{DynamicResource CardStroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="16, 14">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0, 2" Radius="6" Opacity="0.05" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                        <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                VerticalOptions="Center">
                                            <vctrl:IconView Icon="folder"
                                                            IconColor="BrandGreen"
                                                            Size="16"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="Папка с шаблонами"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}" />
                                            <Label x:Name="TemplatesPathLabel"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource TextSecondary}"
                                                   LineBreakMode="MiddleTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Кнопка открыть папку (только Windows) -->
                                    <Border x:Name="OpenTemplatesButton"
                                            StyleClass="HoverCard"
                                            StrokeThickness="1"
                                            Stroke="{DynamicResource CardStroke}"
                                            BackgroundColor="{DynamicResource CardBg}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="12, 9"
                                            InputTransparent="False">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnOpenTemplatesTapped" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" InputTransparent="True">
                                            <vctrl:IconView Icon="folder"
                                                            IconColor="TextPrimary"
                                                            Size="14"
                                                            InputTransparent="True"
                                                            VerticalOptions="Center" />
                                            <Label Text="Открыть в проводнике"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   InputTransparent="True"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>

                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                        <Border Grid.Column="0"
                                                StyleClass="HoverCard"
                                                StrokeThickness="1"
                                                Stroke="{DynamicResource CardStroke}"
                                                BackgroundColor="{DynamicResource CardBg}"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="12, 9"
                                                InputTransparent="False">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPickTemplatesTapped" />
                                            </Border.GestureRecognizers>
                                            <Label Text="Выбрать папку…"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   HorizontalOptions="Center"
                                                   InputTransparent="True" />
                                        </Border>

                                        <Border x:Name="ResetTemplatesButton"
                                                Grid.Column="1"
                                                StyleClass="HoverCard"
                                                StrokeThickness="1"
                                                Stroke="{DynamicResource CardStroke}"
                                                BackgroundColor="{DynamicResource CardBg}"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="12, 9"
                                                InputTransparent="False">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnResetTemplatesTapped" />
                                            </Border.GestureRecognizers>
                                            <Label Text="Сброс"
                                                   FontSize="13"
                                                   TextColor="{DynamicResource TextSecondary}"
                                                   HorizontalOptions="Center"
                                                   InputTransparent="True" />
                                        </Border>
                                    </Grid>

                                    <Label FontSize="11.5"
                                           LineBreakMode="WordWrap"
                                           TextColor="{DynamicResource TextSecondary}"
                                           Text="Шаблоны — файлы .docx с именами «Категория_Название.docx». Поля выделяются квадратными [Поле-Пример] или {фигурными} скобками." />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ===== РАЗДЕЛ: СОХРАНЕНИЕ ФАЙЛОВ ===== -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="СОХРАНЕНИЕ ДОКУМЕНТОВ"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.8"
                                   TextColor="{DynamicResource BrandGreen}" />

                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="{DynamicResource CardStroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="16, 14">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0, 2" Radius="6" Opacity="0.05" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="16">

                                    <!-- Только ПК: выбор папки для сохранения -->
                                    <VerticalStackLayout x:Name="FolderBlock" Spacing="8">
                                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                            <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10"
                                                    WidthRequest="34"
                                                    HeightRequest="34"
                                                    VerticalOptions="Center">
                                                <vctrl:IconView Icon="save"
                                                                IconColor="BrandGreen"
                                                                Size="16"
                                                                HorizontalOptions="Center"
                                                                VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="Папка сохранения"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Label x:Name="FolderPathLabel"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource TextSecondary}"
                                                       LineBreakMode="MiddleTruncation" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                            <Border Grid.Column="0"
                                                    StyleClass="HoverCard"
                                                    StrokeThickness="1"
                                                    Stroke="{DynamicResource CardStroke}"
                                                    BackgroundColor="{DynamicResource CardBg}"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="12, 9"
                                                    InputTransparent="False">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnPickFolderTapped" />
                                                </Border.GestureRecognizers>
                                                <Label Text="Выбрать папку…"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}"
                                                       HorizontalOptions="Center"
                                                       InputTransparent="True" />
                                            </Border>

                                            <Border x:Name="ResetFolderButton"
                                                    Grid.Column="1"
                                                    StyleClass="HoverCard"
                                                    StrokeThickness="1"
                                                    Stroke="{DynamicResource CardStroke}"
                                                    BackgroundColor="{DynamicResource CardBg}"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="12, 9"
                                                    InputTransparent="False">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnResetFolderTapped" />
                                                </Border.GestureRecognizers>
                                                <Label Text="Сброс"
                                                       FontSize="13"
                                                       TextColor="{DynamicResource TextSecondary}"
                                                       HorizontalOptions="Center"
                                                       InputTransparent="True" />
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>

                                    <!-- Только Android: папка в памяти устройства -->
                                    <VerticalStackLayout x:Name="AndroidFolderBlock" Spacing="4">
                                        <Label Text="Каталог сохранения"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="Документы/GosTek. Файлы доступны в системном проводнике."
                                               FontSize="12"
                                               TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>

                                    <!-- Сегмент: Имя файла -->
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Имя файла"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextSecondary}" />
                                        <Grid x:Name="NameHost" />
                                    </VerticalStackLayout>

                                    <!-- Сегмент: Конфликт имён -->
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Если файл уже есть"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextSecondary}" />
                                        <Grid x:Name="ConflictHost" />
                                    </VerticalStackLayout>

                                    <!-- Сегмент: Действие после сохранения -->
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="После сохранения"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextSecondary}" />
                                        <Grid x:Name="AfterSaveHost" />
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ===== РАЗДЕЛ: ОФОРМЛЕНИЕ ===== -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="ОФОРМЛЕНИЕ"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.8"
                                   TextColor="{DynamicResource BrandGreen}" />

                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="{DynamicResource CardStroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="16, 14">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0, 2" Radius="6" Opacity="0.05" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Тема приложения"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextSecondary}" />
                                    <Grid x:Name="ThemeHost" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ===== РАЗДЕЛ: ДАННЫЕ И ПРИВАТНОСТЬ ===== -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="ДАННЫЕ И ПРИВАТНОСТЬ"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.8"
                                   TextColor="{DynamicResource BrandGreen}" />

                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="{DynamicResource CardStroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="16, 14">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0, 2" Radius="6" Opacity="0.05" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                        <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                VerticalOptions="Center">
                                            <vctrl:IconView Icon="shield"
                                                            IconColor="BrandGreen"
                                                            Size="16"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1"
                                               Text="Профиль и шаблоны хранятся локально в зашифрованном виде. При использовании ИИ-ассистента текст запроса и структура полей формы обезличиваются локально перед отправкой в облачный сервис."
                                               FontSize="12"
                                               TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="WordWrap"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" />

                                    <Grid ColumnDefinitions="*, Auto" Margin="0, 2" VerticalOptions="Center">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center" InputTransparent="True">
                                            <Label Text="Разрешить облачный ИИ"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}" />
                                            <Label Text="Отправка обезличенных запросов в сервис ИИ"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource TextSecondary}" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1"
                                                x:Name="AiConsentSwitch"
                                                Toggled="OnAiConsentToggled"
                                                OnColor="{DynamicResource BrandGreen}"
                                                InputTransparent="False"
                                                VerticalOptions="Center" />
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" />

                                    <Grid ColumnDefinitions="*, Auto" Margin="0, 2" VerticalOptions="Center">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center" InputTransparent="True">
                                            <Label Text="Мягкое маскирование имён"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}" />
                                            <Label Text="Автоматически маскировать одиночные подозрительные имена"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource TextSecondary}" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1"
                                                x:Name="AiMaskSilentSwitch"
                                                Toggled="OnAiMaskSilentToggled"
                                                OnColor="{DynamicResource BrandGreen}"
                                                InputTransparent="False"
                                                VerticalOptions="Center" />
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" />

                                    <Border StyleClass="HoverCard"
                                            StrokeThickness="1"
                                            Stroke="{DynamicResource CardStroke}"
                                            BackgroundColor="{DynamicResource CardBg}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="12, 10"
                                            InputTransparent="False">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnClearTempTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Очистить временные файлы"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}"
                                               HorizontalOptions="Center"
                                               InputTransparent="True" />
                                    </Border>

                                    <Border StyleClass="HoverCard"
                                            StrokeThickness="1"
                                            Stroke="#33EF4444"
                                            BackgroundColor="{DynamicResource CardBg}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="12, 10"
                                            InputTransparent="False">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnDeleteProfileTapped" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" InputTransparent="True">
                                            <vctrl:IconView Icon="trash"
                                                            IconColor="#EF4444"
                                                            Size="14"
                                                            VerticalOptions="Center"
                                                            InputTransparent="True" />
                                            <Label Text="Удалить профиль"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#EF4444"
                                                   VerticalOptions="Center"
                                                   InputTransparent="True" />
                                        </HorizontalStackLayout>
                                    </Border>

                                    <Border StyleClass="HoverCard"
                                            StrokeThickness="1"
                                            Stroke="#66EF4444"
                                            BackgroundColor="#15EF4444"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="12, 10"
                                            InputTransparent="False">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnDeleteAllTapped" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" InputTransparent="True">
                                            <vctrl:IconView Icon="alerttriangle"
                                                            IconColor="#EF4444"
                                                            Size="14"
                                                            VerticalOptions="Center"
                                                            InputTransparent="True" />
                                            <Label Text="Сбросить все данные приложения"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#EF4444"
                                                   VerticalOptions="Center"
                                                   InputTransparent="True" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ===== РАЗДЕЛ: О ПРИЛОЖЕНИИ ===== -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="О ПРИЛОЖЕНИИ"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.8"
                                   TextColor="{DynamicResource BrandGreen}" />

                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="{DynamicResource CardStroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="16, 14">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0, 2" Radius="6" Opacity="0.05" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                        <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                VerticalOptions="Center">
                                            <vctrl:IconView Icon="file"
                                                            IconColor="BrandGreen"
                                                            Size="16"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center" />
                                        </Border>
                                        <Label x:Name="VersionLabel"
                                               Grid.Column="1"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <Border StyleClass="HoverCard"
                                            StrokeThickness="1"
                                            Stroke="{DynamicResource CardStroke}"
                                            BackgroundColor="{DynamicResource CardBg}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="12, 10"
                                            InputTransparent="False">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnHelpTapped" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" InputTransparent="True">
                                            <vctrl:IconView Icon="info"
                                                            IconColor="TextPrimary"
                                                            Size="14"
                                                            VerticalOptions="Center"
                                                            InputTransparent="True" />
                                            <Label Text="Как пользоваться"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   VerticalOptions="Center"
                                                   InputTransparent="True" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</ContentView>
