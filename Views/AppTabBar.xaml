<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Адаптивная навигационная панель (левый rail на Windows, нижний бар на Android)
 СОДЕРЖИМОЕ: AppTabBar (ContentView)
 ЗАВИСИМОСТИ: GosTek.Views.AppTabBar, GosTek.Views.Controls.IconView, GosTek.Views.ThemeToggle
 ==============================================================================
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.AppTabBar">

    <Grid>
        <!-- На Windows: Вертикальный левый Navigation Rail (220 px / 64 px) -->
        <Border x:Name="WindowsRail"
                IsVisible="{OnPlatform WinUI=True, Android=False, Default=True}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{DynamicResource TabBarBg}"
                Stroke="{DynamicResource CardStroke}"
                StrokeThickness="1"
                Padding="0">
            <Grid RowDefinitions="Auto, *, Auto">
                <!-- Сверху: Логотип приложения «GosTek» и кнопка сворачивания -->
                <Grid x:Name="WindowsHeaderGrid"
                      Grid.Row="0"
                      Padding="14, 20, 14, 16"
                      ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="8"
                      VerticalOptions="Center">
                    <vctrl:IconView x:Name="LogoIcon"
                                    Icon="file"
                                    Size="24"
                                    IconColor="BrandGreen"
                                    VerticalOptions="Center" />
                    <Label x:Name="LogoLabel"
                           Grid.Column="1"
                           Text="GosTek"
                           FontFamily="PTSansBold"
                           FontSize="27"
                           TextColor="{DynamicResource BrandGreen}"
                           VerticalOptions="Center"
                           LineBreakMode="NoWrap" />
                    <Border x:Name="RailToggleBtn"
                            Grid.Column="2"
                            StyleClass="HoverCard"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="32"
                            HeightRequest="32"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Свернуть/Развернуть панель">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRailToggleTapped" />
                        </Border.GestureRecognizers>
                        <vctrl:IconView x:Name="RailToggleIcon"
                                        Icon="chevronleft"
                                        Size="16"
                                        IconColor="TextSecondary"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Ниже: 5 вкладок вертикальным списком -->
                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout x:Name="WindowsTabsStack"
                                         Spacing="6"
                                         Padding="10, 6" />
                </ScrollView>

                <!-- Снизу: ThemeToggle и кнопка «Настройки» -->
                <VerticalStackLayout x:Name="WindowsFooterStack"
                                     Grid.Row="2"
                                     Spacing="10"
                                     Padding="10, 12, 10, 18">
                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 0, 0, 4" />

                    <!-- Кнопка «Настройки» -->
                    <Border x:Name="WindowsSettingsButton"
                            StyleClass="HoverCard"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12, 10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsClicked" />
                        </Border.GestureRecognizers>
                        <Grid x:Name="WindowsSettingsGrid" ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                            <vctrl:IconView x:Name="WindowsSettingsIcon"
                                            Icon="sliders"
                                            Size="18"
                                            IconColor="TextPrimary"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                            <Label x:Name="WindowsSettingsLabel"
                                   Grid.Column="1"
                                   Text="Настройки"
                                   FontSize="13.5"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Переключатель темы (в развернутом виде) -->
                    <Grid x:Name="WindowsThemeRow"
                          ColumnDefinitions="*, Auto"
                          Padding="4, 2"
                          VerticalOptions="Center">
                        <Label x:Name="WindowsThemeLabel"
                               Text="Тема"
                               FontSize="13"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />
                        <views:ThemeToggle Grid.Column="1"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center" />
                    </Grid>

                    <!-- Компактный переключатель темы (в свернутом виде 64px) -->
                    <Border x:Name="WindowsCompactThemeBtn"
                            IsVisible="False"
                            StyleClass="HoverCard"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            StrokeShape="RoundRectangle 12"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCompactThemeClicked" />
                        </Border.GestureRecognizers>
                        <vctrl:IconView x:Name="CompactThemeIcon"
                                        Icon="moon"
                                        Size="18"
                                        IconColor="TextPrimary"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- На Android: Нижний горизонтальный таббар -->
        <Border x:Name="AndroidBottomBar"
                IsVisible="{OnPlatform Android=True, WinUI=False, Default=False}"
                HorizontalOptions="Fill"
                VerticalOptions="End"
                BackgroundColor="{DynamicResource TabBarBg}"
                Stroke="{DynamicResource CardStroke}"
                StrokeThickness="1"
                Padding="4, 8">
            <Grid x:Name="TabsGrid" HorizontalOptions="Fill" />
        </Border>
    </Grid>
</ContentView>
