<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Пользовательский интерфейс нижней навигационной панели приложения
 СОДЕРЖИМОЕ: ContentView, Grid, Border, Label
 ЗАВИСИМОСТИ: GosTek.Views.AppTabBar
 ==============================================================================
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GosTek.Views.AppTabBar">

    <Border BackgroundColor="{DynamicResource TabBarBg}"
            Stroke="{DynamicResource CardStroke}"
            StrokeThickness="1"
            Padding="4, 8">
        <!-- Вкладки создаются из кода (AppTabBar.xaml.cs, список TabList) -->
        <Grid x:Name="TabsGrid" HorizontalOptions="Fill" />
    </Border>
</ContentView>
