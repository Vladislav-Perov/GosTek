<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Интерфейс экрана сканирования документов через камеру, предобработки и OCR
 СОДЕРЖИМОЕ: ScanPage (ContentPage), видоискатель, панель распознавания, оверлей загрузки
 ЗАВИСИМОСТИ: CommunityToolkit.Maui.Camera, GosTek.Views.Controls.LoadingOverlay, GosTek.Views.Controls.IconView, GosTek.Controls.ChipBar
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GosTek.Controls"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             xmlns:views="clr-namespace:GosTek.Views"
             x:Class="GosTek.Views.ScanPage"
             Title="Сканер"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Акцентные полоски углов видоискателя -->
        <Style x:Key="CornerBar" TargetType="BoxView">
            <Setter Property="Color" Value="{DynamicResource BrandGreen}" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto, Auto"
          MaximumWidthRequest="700"
          HorizontalOptions="Fill">

        <!-- ==================== ШАПКА ==================== -->
        <Grid Grid.Row="0"
              Padding="20, 14, 20, 10"
              ColumnDefinitions="Auto, *"
              ColumnSpacing="14"
              VerticalOptions="Center"
              BackgroundColor="{DynamicResource PageBg}">

            <!-- Кнопка «Закрыть» -->
            <Border Grid.Column="0"
                    StyleClass="HoverCard"
                    StrokeThickness="1"
                    Stroke="{DynamicResource CardStroke}"
                    BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 14"
                    WidthRequest="42"
                    HeightRequest="42"
                    Padding="0"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Закрыть сканер">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.06" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Border.GestureRecognizers>
                <Label Text="✕"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Заголовок страницы -->
            <Label Grid.Column="1"
                   Text="Сканер документов"
                   FontSize="20"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{DynamicResource TextPrimary}" />
        </Grid>

        <!-- ==================== ЦЕНТР: ВИДОИСКАТЕЛЬ ИЛИ РЕЗУЛЬТАТ ==================== -->
        <Grid Grid.Row="1" Margin="20, 4">

            <!-- Рамка видоискателя с акцентными уголками и подсказкой -->
            <Grid x:Name="FramePanel" RowDefinitions="*, Auto, Auto" RowSpacing="12">

                <!-- Область камеры/видоискателя -->
                <Grid x:Name="ViewfinderArea" Grid.Row="0">
                    <Border BackgroundColor="{DynamicResource CardBg}"
                            Stroke="{DynamicResource CardStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 24">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.08" />
                        </Border.Shadow>
                    </Border>

                    <!-- Имитация строк листа при отсутствии активного видеопотока -->
                    <Grid x:Name="LinesHost" Margin="24, 30" InputTransparent="True" />

                    <!-- Хост для нативного элемента камеры CommunityToolkit CameraView -->
                    <Grid x:Name="CameraHost" InputTransparent="True" Margin="2" />

                    <!-- Затемняющая рамка для фокусировки на документе -->
                    <Border StrokeThickness="0"
                            BackgroundColor="#1A000000"
                            StrokeShape="RoundRectangle 24"
                            InputTransparent="True" />

                    <!-- Стильные акцентные уголки видоискателя -->
                    <!-- Верхний левый -->
                    <Grid WidthRequest="36" HeightRequest="36"
                          HorizontalOptions="Start" VerticalOptions="Start"
                          Margin="16" InputTransparent="True">
                        <BoxView Style="{StaticResource CornerBar}" HeightRequest="4" VerticalOptions="Start" HorizontalOptions="Fill" />
                        <BoxView Style="{StaticResource CornerBar}" WidthRequest="4" HorizontalOptions="Start" VerticalOptions="Fill" />
                    </Grid>

                    <!-- Верхний правый -->
                    <Grid WidthRequest="36" HeightRequest="36"
                          HorizontalOptions="End" VerticalOptions="Start"
                          Margin="16" InputTransparent="True">
                        <BoxView Style="{StaticResource CornerBar}" HeightRequest="4" VerticalOptions="Start" HorizontalOptions="Fill" />
                        <BoxView Style="{StaticResource CornerBar}" WidthRequest="4" HorizontalOptions="End" VerticalOptions="Fill" />
                    </Grid>

                    <!-- Нижний левый -->
                    <Grid WidthRequest="36" HeightRequest="36"
                          HorizontalOptions="Start" VerticalOptions="End"
                          Margin="16" InputTransparent="True">
                        <BoxView Style="{StaticResource CornerBar}" HeightRequest="4" VerticalOptions="End" HorizontalOptions="Fill" />
                        <BoxView Style="{StaticResource CornerBar}" WidthRequest="4" HorizontalOptions="Start" VerticalOptions="Fill" />
                    </Grid>

                    <!-- Нижний правый -->
                    <Grid WidthRequest="36" HeightRequest="36"
                          HorizontalOptions="End" VerticalOptions="End"
                          Margin="16" InputTransparent="True">
                        <BoxView Style="{StaticResource CornerBar}" HeightRequest="4" VerticalOptions="End" HorizontalOptions="Fill" />
                        <BoxView Style="{StaticResource CornerBar}" WidthRequest="4" HorizontalOptions="End" VerticalOptions="Fill" />
                    </Grid>

                    <!-- Горизонтальная лазерная полоса сканирования (Laser Line) -->
                    <BoxView x:Name="LaserLine"
                             HeightRequest="2.5"
                             HorizontalOptions="Fill"
                             VerticalOptions="Start"
                             Color="{DynamicResource BrandGreen}"
                             Margin="22, 0"
                             Opacity="0"
                             InputTransparent="True">
                        <BoxView.Shadow>
                            <Shadow Brush="{DynamicResource BrandGreen}" Offset="0, 0" Radius="8" Opacity="0.85" />
                        </BoxView.Shadow>
                    </BoxView>
                </Grid>

                <!-- Подсказка под видоискателем -->
                <Border Grid.Row="1"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14, 10"
                        Margin="4, 0">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <vctrl:IconView Icon="bulb"
                                        IconColor="BrandGreen"
                                        Size="16"
                                        VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Поместите документ целиком в рамку при хорошем освещении."
                               FontSize="12.5"
                               TextColor="{DynamicResource TextSecondary}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Сообщение об ошибке (при наличии) -->
                <Label x:Name="ErrorLabel"
                       Grid.Row="2"
                       IsVisible="False"
                       FontSize="12.5"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       TextColor="#EF4444"
                       Margin="4, 0" />
            </Grid>

            <!-- Результат распознавания (панель скролла) -->
            <ScrollView x:Name="ResultPanel" IsVisible="False" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="14" Padding="0, 4, 0, 16">

                    <!-- Кнопка «Снять заново» в виде аккуратного чипа -->
                    <HorizontalStackLayout Spacing="8">
                        <Border StyleClass="HoverCard"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource CardBg}"
                                Padding="12, 7">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRetakeTapped" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="↩" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource BrandGreen}" VerticalOptions="Center" />
                                <Label Text="Снять заново" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource BrandGreen}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Блок автоматически извлечённых реквизитов (Паспорт / ID) с diff-проверкой -->
                    <VerticalStackLayout x:Name="ExtractedSection" Spacing="12">
                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="16, 14">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.06" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            VerticalOptions="Center">
                                        <vctrl:IconView Icon="sparkles"
                                                        IconColor="BrandGreen"
                                                        Size="16"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Сравнение с профилем"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="Выберите распознанные данные для применения"
                                               FontSize="11.5"
                                               TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>

                                    <!-- Бейдж статуса ICAO 9303 / OCR -->
                                    <Border x:Name="MrzStatusBadge"
                                            Grid.Column="2"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8, 4"
                                            BackgroundColor="#1510B981"
                                            VerticalOptions="Center">
                                        <Label x:Name="MrzStatusLabel"
                                               Text="✓ MRZ ICAO"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#10B981" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" />

                                <!-- ФИО -->
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                                        <CheckBox x:Name="ApplyNameCheck" IsChecked="True" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="ФИО" StyleClass="FieldLabel" />
                                            <Label x:Name="OldNameLabel" Text="Было: —" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Border StyleClass="FieldBox">
                                        <Entry x:Name="NameEntry"
                                               StyleClass="FieldEntry"
                                               Placeholder="Не найдено — введите вручную" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Паспорт -->
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                                        <CheckBox x:Name="ApplyPassportCheck" IsChecked="True" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Паспорт (серия и номер)" StyleClass="FieldLabel" />
                                            <Label x:Name="OldPassportLabel" Text="Было: —" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Border StyleClass="FieldBox">
                                        <Entry x:Name="PassportEntry"
                                               StyleClass="FieldEntry"
                                               Placeholder="Не найдено — введите вручную" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Личный идентификационный номер РБ -->
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                                        <CheckBox x:Name="ApplyPersonalCheck" IsChecked="True" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Идентификационный (личный) номер РБ" StyleClass="FieldLabel" />
                                            <Label x:Name="OldPersonalLabel" Text="Было: —" FontSize="11" TextColor="{DynamicResource TextSecondary}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Border StyleClass="FieldBox">
                                        <Entry x:Name="PersonalEntry"
                                               StyleClass="FieldEntry"
                                               Placeholder="Не найдено — введите вручную" />
                                    </Border>
                                </VerticalStackLayout>

                                <Border StyleClass="HoverGreen"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0"
                                        Padding="0, 13"
                                        Margin="0, 4, 0, 0"
                                        BackgroundColor="{DynamicResource BrandGreen}">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.14" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSaveToProfileTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Применить выбранные в профиль"
                                           FontSize="14.5"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF"
                                           HorizontalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Блок всего распознанного текста -->
                    <Border BackgroundColor="{DynamicResource CardBg}"
                            Stroke="{DynamicResource CardStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="16, 14">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.06" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <Label Text="Распознанный текст"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{DynamicResource TextPrimary}" />

                                <Border Grid.Column="1"
                                        BackgroundColor="{DynamicResource IconBoxBg}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10, 4"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCopyTapped" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="CopyLabel"
                                           Text="Копировать"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           TextColor="{DynamicResource BrandGreen}" />
                                </Border>
                            </Grid>

                            <Border BackgroundColor="{DynamicResource PageBg}"
                                    Stroke="{DynamicResource CardStroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10">
                                <Editor x:Name="RawTextEditor"
                                        IsReadOnly="True"
                                        AutoSize="TextChanges"
                                        FontSize="13"
                                        TextColor="{DynamicResource TextPrimary}"
                                        BackgroundColor="Transparent" />
                            </Border>

                            <Border StyleClass="HoverCard"
                                    Stroke="{DynamicResource CardStroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource CardBg}"
                                    Padding="12, 10"
                                    HorizontalOptions="Fill">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnApplyToTemplateTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <vctrl:IconView Icon="filetext"
                                                    IconColor="BrandGreen"
                                                    Size="16"
                                                    VerticalOptions="Center" />
                                    <Label Text="Перенести текст в шаблон документа..."
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource BrandGreen}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <ActivityIndicator x:Name="Loader"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="{DynamicResource BrandGreen}" />
        </Grid>

        <!-- ==================== ВЫБОР ТИПА ДОКУМЕНТА ==================== -->
        <controls:ChipBar x:Name="KindChips"
                          Grid.Row="2"
                          ChipsPadding="20, 0"
                          Margin="0, 8, 0, 4" />

        <!-- ==================== ПАНЕЛЬ ДЕЙСТВИЙ (ГАЛЕРЕЯ, ЗАТВОР, ФАЙЛ) ==================== -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*, Auto, *"
              VerticalOptions="End">
            <Grid.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="Android" Value="24, 6, 24, 44" />
                    <On Platform="WinUI" Value="24, 8, 24, 18" />
                </OnPlatform>
            </Grid.Padding>

            <!-- Кнопка выбора из галереи -->
            <VerticalStackLayout Grid.Column="0"
                                 Spacing="5"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 SemanticProperties.Description="Выбрать фото из галереи">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGalleryTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Border StyleClass="HoverCard"
                        WidthRequest="52"
                        HeightRequest="52"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource CardBg}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Border.Shadow>
                    <vctrl:IconView Icon="image"
                                    IconColor="TextPrimary"
                                    Size="20"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                </Border>
                <Label Text="Галерея"
                       FontSize="11.5"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource TextSecondary}" />
            </VerticalStackLayout>

            <!-- Основная кнопка затвора камеры -->
            <Border Grid.Column="1"
                    WidthRequest="82"
                    HeightRequest="82"
                    StrokeShape="RoundRectangle 41"
                    StrokeThickness="3"
                    Stroke="{DynamicResource BrandGreen}"
                    BackgroundColor="Transparent"
                    Padding="5"
                    SemanticProperties.Description="Сфотографировать">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0, 4" Radius="12" Opacity="0.16" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnShutterTapped" />
                </Border.GestureRecognizers>
                <Border StrokeShape="RoundRectangle 34"
                        StrokeThickness="0"
                        Background="{DynamicResource BrandGreenGradient}">
                    <vctrl:IconView Icon="camera"
                                    IconColor="White"
                                    Size="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                </Border>
            </Border>

            <!-- Кнопка выбора файла -->
            <VerticalStackLayout Grid.Column="2"
                                 Spacing="5"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 SemanticProperties.Description="Выбрать файл с изображением">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFileTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Border StyleClass="HoverCard"
                        WidthRequest="52"
                        HeightRequest="52"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource CardBg}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Border.Shadow>
                    <vctrl:IconView Icon="folder"
                                    IconColor="TextPrimary"
                                    Size="20"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                </Border>
                <Label Text="Файл"
                       FontSize="11.5"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource TextSecondary}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Полноэкранный оверлей индикации процесса (захват, улучшение, OCR) -->
        <vctrl:LoadingOverlay x:Name="ScanLoading"
                              Grid.Row="0"
                              Grid.RowSpan="4"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill" />

    </Grid>
</ContentPage>
