<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Интерфейс экрана сканирования документов через камеру, предобработки и OCR
 СОДЕРЖИМОЕ: ScanPage (ContentPage), видоискатель, панель распознавания, оверлей загрузки
 ЗАВИСИМОСТИ: CommunityToolkit.Maui.Camera, GosTek.Views.Controls.LoadingOverlay, GosTek.Views.Controls.IconView, GosTek.Controls.ChipBar
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GosTek.Controls"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             xmlns:views="clr-namespace:GosTek.Views"
             x:Class="GosTek.Views.ScanPage"
             Title="Сканер"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="{OnPlatform Android=Container, Default=None}">

    <ContentPage.Resources>
        <!-- Акцентные полоски углов видоискателя -->
        <Style x:Key="CornerBar" TargetType="BoxView">
            <Setter Property="Color" Value="{DynamicResource BrandGreen}" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto"
          MaximumWidthRequest="{OnPlatform Android=700, Default=1250}"
          HorizontalOptions="Fill">

        <!-- ==================== ШАПКА ==================== -->
        <Grid Grid.Row="0"
              Padding="20, 14, 20, 10"
              ColumnDefinitions="Auto, *"
              ColumnSpacing="14"
              VerticalOptions="Center"
              BackgroundColor="{DynamicResource PageBg}">

            <!-- Кнопка «Закрыть» -->
            <Border Grid.Column="0"
                    StyleClass="HoverCard"
                    StrokeThickness="1"
                    Stroke="{DynamicResource CardStroke}"
                    BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 14"
                    WidthRequest="42"
                    HeightRequest="42"
                    Padding="0"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Закрыть сканер">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.06" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Border.GestureRecognizers>
                <vctrl:IconView Icon="close" Size="20" />
            </Border>

            <!-- Заголовок страницы -->
            <Label x:Name="PageTitleLabel"
                   Grid.Column="1"
                   Text="Сканер документов"
                   FontSize="20"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{DynamicResource TextPrimary}" />
        </Grid>

        <!-- ==================== ЦЕНТР: ВИДОИСКАТЕЛЬ ИЛИ РЕЗУЛЬТАТ ==================== -->
        <Grid Grid.Row="1" Margin="20, 4" ColumnSpacing="16"
              ColumnDefinitions="{OnPlatform WinUI='*,1.15*', Default='*'}">

            <Border x:Name="DesktopDropZone" IsVisible="{OnPlatform WinUI=True, Default=False}"
                    BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardStroke}"
                    StrokeShape="RoundRectangle 12" Padding="16">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Label Text="Исходное изображение" FontAttributes="Bold" FontSize="17"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Image x:Name="DesktopImage" Grid.Row="1" Aspect="AspectFit" IsVisible="False" />
                    <VerticalStackLayout x:Name="DesktopDropHint" Grid.Row="1" Spacing="12"
                                         VerticalOptions="Center" HorizontalOptions="Center">
                        <vctrl:IconView Icon="image" Size="40" IconColor="TextSecondary" />
                        <Label Text="Перетащите фото или скан сюда" HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="JPG или PNG" HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Label x:Name="DesktopFileName" Grid.Row="2" LineBreakMode="MiddleTruncation"
                           TextColor="{DynamicResource TextSecondary}" />
                </Grid>
            </Border>

            <VerticalStackLayout x:Name="DesktopInputPanel" Grid.Column="{OnPlatform WinUI=1, Default=0}"
                                 IsVisible="{OnPlatform WinUI=True, Default=False}"
                                 VerticalOptions="Center" Spacing="12" Padding="12">
                <Label Text="Оцифровка изображения" FontSize="22" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />
                <Label Text="Загрузите фото документа, распознайте текст и проверьте его по оригиналу."
                       TextColor="{DynamicResource TextSecondary}" />
                <Button Text="Выбрать изображение" Clicked="OnChooseDesktopImageClicked" />
                <Button x:Name="RecognizeDesktopButton" Text="Распознать текст"
                        Clicked="OnRecognizeDesktopClicked" IsEnabled="False"
                        BackgroundColor="{DynamicResource ActionBg}" TextColor="White" />
                <Label x:Name="DesktopError" IsVisible="False" TextColor="{DynamicResource BadColor}" />
            </VerticalStackLayout>

            <!-- Рамка видоискателя с акцентными уголками и подсказкой -->
            <Grid x:Name="FramePanel" IsVisible="{OnPlatform Android=True, Default=False}"
                  RowDefinitions="*, Auto, Auto" RowSpacing="12">

                <!-- Область камеры/видоискателя -->
                <Grid x:Name="ViewfinderArea" Grid.Row="0" HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid x:Name="ViewfinderContainer"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          IsClippedToBounds="True">
                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 24">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.08" />
                            </Border.Shadow>
                        </Border>

                        <!-- Имитация строк листа при отсутствии активного видеопотока -->
                        <Grid x:Name="LinesHost" Margin="24, 30" InputTransparent="True" />

                        <!-- Хост для нативного элемента камеры CommunityToolkit CameraView -->
                        <Grid x:Name="CameraHost" InputTransparent="True" Margin="2" />

                        <!-- Затемняющая рамка для фокусировки на документе -->
                        <Border StrokeThickness="0"
                                BackgroundColor="#1A000000"
                                StrokeShape="RoundRectangle 24"
                                InputTransparent="True" />

                        <!-- Стильные акцентные уголки видоискателя -->
                        <!-- Верхний левый -->
                        <Grid WidthRequest="36" HeightRequest="36"
                              HorizontalOptions="Start" VerticalOptions="Start"
                              Margin="16" InputTransparent="True">
                            <BoxView Style="{StaticResource CornerBar}" HeightRequest="4" VerticalOptions="Start" HorizontalOptions="Fill" />
                            <BoxView Style="{StaticResource CornerBar}" WidthRequest="4" HorizontalOptions="Start" VerticalOptions="Fill" />
                        </Grid>

                        <!-- Верхний правый -->
                        <Grid WidthRequest="36" HeightRequest="36"
                              HorizontalOptions="End" VerticalOptions="Start"
                              Margin="16" InputTransparent="True">
                            <BoxView Style="{StaticResource CornerBar}" HeightRequest="4" VerticalOptions="Start" HorizontalOptions="Fill" />
                            <BoxView Style="{StaticResource CornerBar}" WidthRequest="4" HorizontalOptions="End" VerticalOptions="Fill" />
                        </Grid>

                        <!-- Нижний левый -->
                        <Grid WidthRequest="36" HeightRequest="36"
                              HorizontalOptions="Start" VerticalOptions="End"
                              Margin="16" InputTransparent="True">
                            <BoxView Style="{StaticResource CornerBar}" HeightRequest="4" VerticalOptions="End" HorizontalOptions="Fill" />
                            <BoxView Style="{StaticResource CornerBar}" WidthRequest="4" HorizontalOptions="Start" VerticalOptions="Fill" />
                        </Grid>

                        <!-- Нижний правый -->
                        <Grid WidthRequest="36" HeightRequest="36"
                              HorizontalOptions="End" VerticalOptions="End"
                              Margin="16" InputTransparent="True">
                            <BoxView Style="{StaticResource CornerBar}" HeightRequest="4" VerticalOptions="End" HorizontalOptions="Fill" />
                            <BoxView Style="{StaticResource CornerBar}" WidthRequest="4" HorizontalOptions="End" VerticalOptions="Fill" />
                        </Grid>

                        <!-- Горизонтальная лазерная полоса сканирования (Laser Line) -->
                        <BoxView x:Name="LaserLine"
                                 HeightRequest="2.5"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Start"
                                 Color="{DynamicResource BrandGreen}"
                                 Margin="22, 0"
                                 Opacity="0"
                                 InputTransparent="True">
                            <BoxView.Shadow>
                                <Shadow Brush="{DynamicResource BrandGreen}" Offset="0, 0" Radius="8" Opacity="0.85" />
                            </BoxView.Shadow>
                        </BoxView>
                    </Grid>
                </Grid>

                <!-- Подсказка под видоискателем -->
                <Border Grid.Row="1"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14, 10"
                        Margin="4, 0">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <vctrl:IconView Icon="bulb"
                                        IconColor="BrandGreen"
                                        Size="20"
                                        VerticalOptions="Center" />
                        <Label x:Name="ViewfinderHintLabel"
                               Grid.Column="1"
                               Text="Нажмите круглую кнопку для съёмки с автофокусом и высоким разрешением."
                               FontSize="14"
                               TextColor="{DynamicResource TextSecondary}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Сообщение об ошибке (при наличии) -->
                <Label x:Name="ErrorLabel"
                       Grid.Row="2"
                       IsVisible="False"
                       FontSize="14"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       TextColor="{DynamicResource BadColor}"
                       Margin="4, 0" />
            </Grid>

            <!-- Результат распознавания (панель скролла) -->
            <ScrollView x:Name="ResultPanel" Grid.Column="{OnPlatform WinUI=1, Default=0}"
                        IsVisible="False" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="14" Padding="{OnPlatform Android='0, 4, 0, 36', WinUI='0, 4, 0, 16'}">

                    <!-- Кнопка «Снять заново» в виде аккуратного чипа -->
                    <HorizontalStackLayout Spacing="8">
                        <Border StyleClass="HoverCard"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource CardBg}"
                                Padding="12, 7">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRetakeTapped" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="↩" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource BrandGreen}" VerticalOptions="Center" />
                                <Label Text="{OnPlatform WinUI='Другое изображение', Default='Снять заново'}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource BrandGreen}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Блок автоматически извлечённых реквизитов (Паспорт / ID) с diff-проверкой -->
                    <VerticalStackLayout x:Name="ExtractedSection" Spacing="12">
                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="16, 14">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.06" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            VerticalOptions="Center">
                                        <vctrl:IconView Icon="check_ok"
                                                        IconColor="BrandGreen"
                                                        Size="20"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Сравнение с профилем"
                                               FontSize="17"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="Выберите распознанные данные для применения"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>

                                    <!-- Бейдж статуса ICAO 9303 / OCR -->
                                    <Border x:Name="MrzStatusBadge"
                                            Grid.Column="2"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8, 4"
                                            BackgroundColor="{DynamicResource IconBoxBg}"
                                            VerticalOptions="Center">
                                        <Label x:Name="MrzStatusLabel"
                                               Text="MRZ · ICAO"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource BrandGreen}" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" />

                                <!-- ФИО -->
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                                        <CheckBox x:Name="ApplyNameCheck" IsChecked="True" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="ФИО" StyleClass="FieldLabel" />
                                            <Label x:Name="OldNameLabel" Text="Было: —" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Border StyleClass="FieldBox">
                                        <Entry x:Name="NameEntry"
                                               StyleClass="FieldEntry"
                                               Placeholder="Не найдено — введите вручную" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Паспорт -->
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                                        <CheckBox x:Name="ApplyPassportCheck" IsChecked="True" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Паспорт (серия и номер)" StyleClass="FieldLabel" />
                                            <Label x:Name="OldPassportLabel" Text="Было: —" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Border StyleClass="FieldBox">
                                        <Entry x:Name="PassportEntry"
                                               StyleClass="FieldEntry"
                                               Placeholder="Не найдено — введите вручную" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Личный идентификационный номер РБ -->
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                                        <CheckBox x:Name="ApplyPersonalCheck" IsChecked="True" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Идентификационный (личный) номер РБ" StyleClass="FieldLabel" />
                                            <Label x:Name="OldPersonalLabel" Text="Было: —" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Border StyleClass="FieldBox">
                                        <Entry x:Name="PersonalEntry"
                                               StyleClass="FieldEntry"
                                               Placeholder="Не найдено — введите вручную" />
                                    </Border>
                                </VerticalStackLayout>

                                <Border StyleClass="HoverGreen"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0"
                                        Padding="0, 13"
                                        Margin="0, 4, 0, 0"
                                        BackgroundColor="{DynamicResource ActionBg}">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.14" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSaveToProfileTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Применить выбранные в профиль"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF"
                                           HorizontalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Переключатель режима: [Предпросмотр А4] / [Редактирование] -->
                    <Border BackgroundColor="{DynamicResource IconBoxBg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            Padding="4"
                            HorizontalOptions="Fill">
                        <Grid ColumnDefinitions="*, *">
                            <Border x:Name="TabPreviewBtn"
                                    Grid.Column="0"
                                    BackgroundColor="{DynamicResource CardBg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 11"
                                    Padding="10, 8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTabPreviewTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                    <vctrl:IconView Icon="eye" IconColor="BrandGreen" Size="20" VerticalOptions="Center" />
                                    <Label x:Name="TabPreviewLabel"
                                           Text="Предпросмотр А4"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource BrandGreen}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border x:Name="TabEditBtn"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 11"
                                    Padding="10, 8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTabEditTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                    <vctrl:IconView Icon="edit" IconColor="TextSecondary" Size="20" VerticalOptions="Center" />
                                    <Label x:Name="TabEditLabel"
                                           Text="Редактировать текст"
                                           FontSize="15"
                                           FontAttributes="None"
                                           TextColor="{DynamicResource TextSecondary}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- КОНТЕЙНЕР 1: Интерактивный лист А4 предпросмотра ГОСТ -->
                    <Border x:Name="A4PreviewSheet"
                            BackgroundColor="#FFFFFF"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="22, 26"
                            HorizontalOptions="Fill">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0, 4" Radius="10" Opacity="0.10" />
                        </Border.Shadow>

                        <VerticalStackLayout x:Name="A4DocumentContent" Spacing="8">
                            <!-- Абзацы документа генерируются динамически по правилам ГОСТ -->
                        </VerticalStackLayout>
                    </Border>

                    <!-- КОНТЕЙНЕР 2: Редактируемое поле с распознанным текстом -->
                    <Border x:Name="TextEditorContainer"
                            IsVisible="False"
                            BackgroundColor="{DynamicResource CardBg}"
                            Stroke="{DynamicResource CardStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="16, 14">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.06" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="Редактирование текста"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}" />
                                    <Label Text="Исправьте опечатки перед формированием документа"
                                           FontSize="13"
                                           TextColor="{DynamicResource TextSecondary}" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="10, 5"
                                            VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCopyTapped" />
                                        </Border.GestureRecognizers>
                                        <Label x:Name="CopyLabel"
                                               Text="Копировать"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               TextColor="{DynamicResource BrandGreen}" />
                                    </Border>
                                </HorizontalStackLayout>
                            </Grid>

                            <Border BackgroundColor="{DynamicResource PageBg}"
                                    Stroke="{DynamicResource CardStroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10">
                                <Editor x:Name="RawTextEditor"
                                        IsReadOnly="False"
                                        AutoSize="TextChanges"
                                        FontSize="15"
                                        TextColor="{DynamicResource TextPrimary}"
                                        BackgroundColor="Transparent"
                                        TextChanged="OnRawTextChanged" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Блок настройки параметров оформления ГОСТ -->
                    <Border BackgroundColor="{DynamicResource CardBg}"
                            Stroke="{DynamicResource CardStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="16, 14">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.06" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="10">
                            <!-- Секция настройки параметров ГОСТ (сворачиваемая) -->
                            <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12, 10">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <vctrl:IconView Icon="settings" IconColor="BrandGreen" Size="20" VerticalOptions="Center" />
                                            <Label Text="Параметры оформления ГОСТ" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="По умолчанию"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource BrandGreen}"
                                               VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnResetGostOptionsTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>

                                    <!-- Строка 1: Шрифт и размер -->
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="Шрифт:" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                            <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="6, 2">
                                                <Picker x:Name="FontPicker" FontSize="14" TextColor="{DynamicResource TextPrimary}" SelectedIndexChanged="OnFormattingOptionChanged">
                                                    <Picker.ItemsSource>
                                                        <x:Array Type="{x:Type x:String}">
                                                            <x:String>Times New Roman</x:String>
                                                            <x:String>Arial</x:String>
                                                            <x:String>Calibri</x:String>
                                                        </x:Array>
                                                    </Picker.ItemsSource>
                                                    <Picker.SelectedIndex>0</Picker.SelectedIndex>
                                                </Picker>
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="Размер шрифта:" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                            <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="6, 2">
                                                <Picker x:Name="FontSizePicker" FontSize="14" TextColor="{DynamicResource TextPrimary}" SelectedIndexChanged="OnFormattingOptionChanged">
                                                    <Picker.ItemsSource>
                                                        <x:Array Type="{x:Type x:String}">
                                                            <x:String>12 пт</x:String>
                                                            <x:String>13 пт</x:String>
                                                            <x:String>14 пт (ГОСТ)</x:String>
                                                        </x:Array>
                                                    </Picker.ItemsSource>
                                                    <Picker.SelectedIndex>2</Picker.SelectedIndex>
                                                </Picker>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Строка 2: Интервал и Красная строка -->
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="Межстрочный интервал:" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                            <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="6, 2">
                                                <Picker x:Name="LineSpacingPicker" FontSize="14" TextColor="{DynamicResource TextPrimary}" SelectedIndexChanged="OnFormattingOptionChanged">
                                                    <Picker.ItemsSource>
                                                        <x:Array Type="{x:Type x:String}">
                                                            <x:String>1.0 (Одинарный)</x:String>
                                                            <x:String>1.15</x:String>
                                                            <x:String>1.5 (ГОСТ)</x:String>
                                                        </x:Array>
                                                    </Picker.ItemsSource>
                                                    <Picker.SelectedIndex>2</Picker.SelectedIndex>
                                                </Picker>
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="Отступ (красная строка):" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                            <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="6, 2">
                                                <Picker x:Name="IndentPicker" FontSize="14" TextColor="{DynamicResource TextPrimary}" SelectedIndexChanged="OnFormattingOptionChanged">
                                                    <Picker.ItemsSource>
                                                        <x:Array Type="{x:Type x:String}">
                                                            <x:String>Без отступа (0 см)</x:String>
                                                            <x:String>1.0 см</x:String>
                                                            <x:String>1.25 см (ГОСТ)</x:String>
                                                            <x:String>1.5 см</x:String>
                                                        </x:Array>
                                                    </Picker.ItemsSource>
                                                    <Picker.SelectedIndex>2</Picker.SelectedIndex>
                                                </Picker>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Строка 3: Поля страницы -->
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="Выравнивание:" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                            <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="6, 2">
                                                <Picker x:Name="AlignPicker" FontSize="14" TextColor="{DynamicResource TextPrimary}" SelectedIndexChanged="OnFormattingOptionChanged">
                                                    <Picker.ItemsSource>
                                                        <x:Array Type="{x:Type x:String}">
                                                            <x:String>По ширине (ГОСТ)</x:String>
                                                            <x:String>По левому краю</x:String>
                                                        </x:Array>
                                                    </Picker.ItemsSource>
                                                    <Picker.SelectedIndex>0</Picker.SelectedIndex>
                                                </Picker>
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="Поля документа:" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                            <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="6, 2">
                                                <Picker x:Name="MarginsPicker" FontSize="14" TextColor="{DynamicResource TextPrimary}" SelectedIndexChanged="OnFormattingOptionChanged">
                                                    <Picker.ItemsSource>
                                                        <x:Array Type="{x:Type x:String}">
                                                            <x:String>ГОСТ (30-15-20-20 мм)</x:String>
                                                            <x:String>Стандартные (20-20-20-20 мм)</x:String>
                                                            <x:String>Широкие (30-20-20-20 мм)</x:String>
                                                        </x:Array>
                                                    </Picker.ItemsSource>
                                                    <Picker.SelectedIndex>0</Picker.SelectedIndex>
                                                </Picker>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Главная кнопка: Сохранить и экспортировать в DOCX по ГОСТ -->
                            <Border StyleClass="HoverCard"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{DynamicResource ActionBg}"
                                    Padding="14, 12"
                                    HorizontalOptions="Fill">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.12" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnExportGostDocxTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                                    <vctrl:IconView Icon="download"
                                                    IconColor="White"
                                                    Size="22"
                                                    VerticalOptions="Center" />
                                    <Label Text="Оцифровать в DOCX по ГОСТ"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Button Text="Экспортировать PDF" IsVisible="{OnPlatform WinUI=True, Default=False}"
                                    Clicked="OnExportGostPdfClicked" />

                            <!-- Кнопка: Создать ГОСТ-шаблон из этого текста -->
                            <Border StyleClass="HoverCard"
                                    Stroke="{DynamicResource BrandGreen}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource CardBg}"
                                    Padding="12, 10"
                                    HorizontalOptions="Fill">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCreateTemplateFromOcrTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <vctrl:IconView Icon="templates"
                                                    IconColor="BrandGreen"
                                                    Size="20"
                                                    VerticalOptions="Center" />
                                    <Label Text="Сохранить как шаблон приложения"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource BrandGreen}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Кнопка 2: Перенести в существующий шаблон -->
                            <Border StyleClass="HoverCard"
                                    Stroke="{DynamicResource CardStroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource CardBg}"
                                    Padding="12, 10"
                                    HorizontalOptions="Fill">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnApplyToTemplateTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <vctrl:IconView Icon="filetext"
                                                    IconColor="TextSecondary"
                                                    Size="20"
                                                    VerticalOptions="Center" />
                                    <Label Text="Выбрать существующий шаблон..."
                                           FontSize="15"
                                           TextColor="{DynamicResource TextSecondary}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <ActivityIndicator x:Name="Loader"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="{DynamicResource BrandGreen}" />
        </Grid>

        <!-- ==================== ПАНЕЛЬ ДЕЙСТВИЙ (ГАЛЕРЕЯ, ЗАТВОР, ФАЙЛ) ==================== -->
        <Grid Grid.Row="2"
              IsVisible="{OnPlatform Android=True, Default=False}"
              ColumnDefinitions="*, Auto, *"
              VerticalOptions="End">
            <Grid.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="Android" Value="24, 6, 24, 44" />
                    <On Platform="WinUI" Value="24, 8, 24, 18" />
                </OnPlatform>
            </Grid.Padding>

            <!-- Кнопка выбора из галереи -->
            <VerticalStackLayout Grid.Column="0"
                                 Spacing="5"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 SemanticProperties.Description="Выбрать фото из галереи">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGalleryTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Border StyleClass="HoverCard"
                        WidthRequest="52"
                        HeightRequest="52"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource CardBg}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Border.Shadow>
                    <vctrl:IconView Icon="image"
                                    IconColor="TextPrimary"
                                    Size="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                </Border>
                <Label Text="Галерея"
                       FontSize="13"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource TextSecondary}" />
            </VerticalStackLayout>

            <!-- Основная кнопка затвора камеры -->
            <Border Grid.Column="1"
                    WidthRequest="82"
                    HeightRequest="82"
                    StrokeShape="RoundRectangle 41"
                    StrokeThickness="3"
                    Stroke="{DynamicResource BrandGreen}"
                    BackgroundColor="Transparent"
                    Padding="5"
                    SemanticProperties.Description="Сфотографировать">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0, 4" Radius="12" Opacity="0.16" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnShutterTapped" />
                </Border.GestureRecognizers>
                <Border StrokeShape="RoundRectangle 34"
                        StrokeThickness="0"
                        BackgroundColor="{DynamicResource ActionBg}">
                    <vctrl:IconView Icon="camera"
                                    IconColor="White"
                                    Size="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                </Border>
            </Border>

            <!-- Кнопка выбора файла -->
            <VerticalStackLayout Grid.Column="2"
                                 Spacing="5"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 SemanticProperties.Description="Выбрать файл с изображением">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFileTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Border StyleClass="HoverCard"
                        WidthRequest="52"
                        HeightRequest="52"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource CardBg}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Border.Shadow>
                    <vctrl:IconView Icon="folder"
                                    IconColor="TextPrimary"
                                    Size="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                </Border>
                <Label Text="Файл"
                       FontSize="13"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource TextSecondary}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Полноэкранный оверлей индикации процесса (захват, улучшение, OCR) -->
        <vctrl:LoadingOverlay x:Name="ScanLoading"
                              Grid.Row="0"
                              Grid.RowSpan="4"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill" />

    </Grid>
</ContentPage>
