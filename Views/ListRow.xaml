<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GosTek.Views.ListRow">

    <!-- Строка-карточка: иконка, заголовок, подпись, стрелка -->
    <Border StyleClass="HoverCard"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            Padding="14">
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
            <Border Grid.Column="0"
                    BackgroundColor="{DynamicResource IconBoxBg}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    WidthRequest="40" HeightRequest="40"
                    VerticalOptions="Center">
                <Label x:Name="IconLabel" FontSize="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label x:Name="TitleLabel" FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />
                <Label x:Name="SubtitleLabel" FontSize="12"
                       TextColor="{DynamicResource TextSecondary}"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <Path Grid.Column="2" Data="M2,1 L8,8 L2,15" Stroke="{DynamicResource TextSecondary}" StrokeThickness="2.5" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform" WidthRequest="10" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
