<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Унифицированный компонент строки списка с векторной иконкой, заголовком и избранным
 СОДЕРЖИМОЕ: ContentView, Grid, Label, Border, IconView, Path
 ЗАВИСИМОСТИ: GosTek.Views.ListRow, GosTek.Controls.BounceEffect, GosTek.Views.Controls.IconView
 ==============================================================================
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.ListRow"
             HorizontalOptions="Fill">

    <!-- Строка-карточка: векторная иконка в плашке, заголовок, подпись, избранное, стрелка перехода -->
    <Border StyleClass="HoverCard"
            StrokeShape="RoundRectangle 18"
            Stroke="{DynamicResource CardStroke}"
            BackgroundColor="{DynamicResource CardBg}"
            StrokeThickness="1"
            Padding="16, 14"
            HorizontalOptions="Fill">
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">
            <!-- Плашка для векторной иконки документа -->
            <Border Grid.Column="0"
                    BackgroundColor="{DynamicResource IconBoxBg}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    WidthRequest="42"
                    HeightRequest="42"
                    VerticalOptions="Center">
                <vctrl:IconView x:Name="IconCtrl"
                                Icon="file"
                                IconColor="BrandGreen"
                                Size="20"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
            </Border>

            <!-- Заголовок и подзаголовок -->
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label x:Name="TitleLabel"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />
                <Label x:Name="SubtitleLabel"
                       FontSize="12.5"
                       TextColor="{DynamicResource TextSecondary}"
                       LineBreakMode="TailTruncation" />
                <Label x:Name="DetailsLabel"
                       IsVisible="False"
                       FontSize="11.5"
                       TextColor="{DynamicResource TextSecondary}"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <!-- Кнопка «В избранное» (по умолчанию скрыта) -->
            <Border x:Name="FavoriteButton"
                    Grid.Column="2"
                    IsVisible="False"
                    WidthRequest="36"
                    HeightRequest="36"
                    StrokeThickness="0"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center"
                    Padding="2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFavoriteTapped" />
                </Border.GestureRecognizers>
                <!-- Векторная звезда избранного -->
                <vctrl:IconView x:Name="FavoriteCtrl"
                                Icon="star"
                                IconColor="TextSecondary"
                                Size="18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
            </Border>

            <!-- Векторная стрелка перехода -->
            <Path Grid.Column="3"
                  Data="M2,1 L8,8 L2,15"
                  Stroke="{DynamicResource TextSecondary}"
                  StrokeThickness="2.2"
                  StrokeLineCap="Round"
                  StrokeLineJoin="Round"
                  Aspect="Uniform"
                  WidthRequest="9"
                  HeightRequest="14"
                  HorizontalOptions="Center"
                  VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
