<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             xmlns:controls="clr-namespace:GosTek.Controls"
             x:Class="GosTek.Views.CheckPage"
             Title="Проверка"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto, Auto">

        <!-- ==================== ШАПКА ==================== -->
        <Grid Grid.Row="0"
              Padding="20, 15, 20, 10"
              ColumnDefinitions="*, Auto"
              ColumnSpacing="12">
            <Label Text="Проверка"
                   FontSize="26"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{DynamicResource TextPrimary}" />

            <views:ThemeToggle Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" />
        </Grid>

        <!-- ==================== ТЕЛО ==================== -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout MaximumWidthRequest="700"
                                 HorizontalOptions="Fill"
                                 Padding="20,4,20,20"
                                 Spacing="14">

                <!-- Карточка файла -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="12">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="📄"
                               FontSize="28"
                               VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="FileNameLabel"
                                   Text="Документ не выбран"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   LineBreakMode="MiddleTruncation"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Label x:Name="FileInfoLabel"
                                   Text="Подойдёт файл Word (.docx)"
                                   FontSize="13"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="2"
                                StyleClass="HoverCard"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="14,8"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickTapped" />
                            </Border.GestureRecognizers>
                            <Label x:Name="PickLabel"
                                   Text="Выбрать"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Правила проверки (чипы создаются из кода) -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Правила проверки" StyleClass="FieldLabel" />
                    <controls:ChipBar x:Name="RuleChips" />
                    <Label x:Name="RuleNote"
                           IsVisible="False"
                           Text="Для этого набора пока действуют универсальные правила. Отдельные появятся позже."
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- Пока файл не выбран -->
                <VerticalStackLayout x:Name="EmptyPanel" Spacing="8" Margin="0,20,0,0">
                    <Label Text="Проверим оформление без ИИ"
                           FontSize="17"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Label Text="Поля страницы, шрифт, размер и интервал, нумерацию и обязательные разделы. Простые ошибки исправим одной кнопкой. Файл остаётся на устройстве."
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- Результат проверки -->
                <VerticalStackLayout x:Name="ResultPanel" IsVisible="False" Spacing="8">
                    <Label x:Name="StatusLabel"
                           IsVisible="False"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           TextColor="{DynamicResource BrandGreen}" />

                    <Border x:Name="SummaryBox"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,12"
                            Margin="0,0,0,4">
                        <Label x:Name="SummaryLabel"
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               TextColor="{DynamicResource TextPrimary}" />
                    </Border>

                    <!-- Замечания создаются из кода -->
                    <VerticalStackLayout x:Name="IssuesHost" Spacing="8" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="Loader"
                           Grid.Row="1"
                           IsRunning="False"
                           IsVisible="False"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{DynamicResource AccentGreen}" />

        <!-- ==================== ПАНЕЛЬ ДЕЙСТВИЙ ==================== -->
        <VerticalStackLayout Grid.Row="2" Spacing="0">
            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />

            <Grid x:Name="ActionBar"
                  ColumnDefinitions="*, *"
                  ColumnSpacing="8"
                  Padding="16,10,16,14"
                  MaximumWidthRequest="700">

                <Border x:Name="PrimaryButton"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        StyleClass="HoverGreen"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="0"
                        Padding="8,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrimaryTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="PrimaryLabel"
                           Text="Выбрать документ"
                           FontSize="15"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"
                           TextColor="#064E3B"
                           HorizontalOptions="Center" />
                </Border>

                <Border x:Name="SaveButton"
                        Grid.Column="1"
                        IsVisible="False"
                        StyleClass="HoverCard"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1"
                        Padding="8,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaveCopyTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Сохранить копию"
                           FontSize="15"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"
                           TextColor="{DynamicResource TextPrimary}"
                           HorizontalOptions="Center" />
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!-- ==================== ТАББАР ==================== -->
        <views:AppTabBar x:Name="BottomTabs" Grid.Row="3" ActiveTab="check" />

    </Grid>
</ContentPage>
