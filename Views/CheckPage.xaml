<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Премиальный интерфейс аудита оформления документов по ГОСТ
 СОДЕРЖИМОЕ: Единый скролл, карточка файла, карточка стандарта, сворачиваемые карточки замечаний
 ЗАВИСИМОСТИ: GosTek.Views.CheckPage, GosTek.Views.CheckGroupVm, GosTek.Controls.ChipBar, GosTek.Views.Controls.IconView
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             xmlns:models="clr-namespace:GosTek.Models"
             xmlns:controls="clr-namespace:GosTek.Controls"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.CheckPage"
             x:Name="Root"
             x:DataType="views:CheckPage"
             Title="Проверка"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="{OnPlatform Android=Container, Default=None}">

    <Grid RowDefinitions="*">

        <!-- ==================== ОСНОВНОЙ КОНТЕНТ СО СКРОЛЛОМ ==================== -->
        <ScrollView Grid.Row="0"
                    Orientation="Vertical"
                    VerticalScrollBarVisibility="Default">
            <VerticalStackLayout MaximumWidthRequest="950"
                                 HorizontalOptions="Fill"
                                 Padding="20, 20, 20, 24"
                                 Spacing="16">

                <!-- Шапка страницы -->
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Проверка"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Label Text="Инспектор оформления документов по ГОСТ"
                           FontSize="13"
                           TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- Карточка стандарта оформления -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16, 14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    VerticalOptions="Center">
                                <vctrl:IconView Icon="ruler"
                                                IconColor="BrandGreen"
                                                Size="18"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Стандарт оформления"
                                       FontSize="14.5"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Активный профиль ГОСТ"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    StyleClass="HoverCard"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CardStroke}"
                                    BackgroundColor="{DynamicResource CardHoverBg}"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10, 6"
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditCurrentRuleTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <vctrl:IconView Icon="pen"
                                                    IconColor="BrandGreen"
                                                    Size="13"
                                                    VerticalOptions="Center" />
                                    <Label x:Name="EditCurrentRuleLabel"
                                           Text="Настроить"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource BrandGreen}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" />

                        <controls:ChipBar x:Name="RuleChips"
                                          ChipsPadding="0, 2, 0, 2" />

                        <Label x:Name="RuleNote"
                               IsVisible="False"
                               FontSize="12"
                               LineBreakMode="WordWrap"
                               TextColor="{DynamicResource TextSecondary}"
                               Margin="2, 0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Зона выбора файла (Dropzone) (когда файл не выбран) -->
                <Border x:Name="DropzoneBorder"
                        StyleClass="HoverCard"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeDashArray="5,5"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 18"
                        Padding="24, 28"
                        HorizontalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPickTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                WidthRequest="48"
                                HeightRequest="48"
                                HorizontalOptions="Center">
                            <vctrl:IconView Icon="file"
                                            IconColor="BrandGreen"
                                            Size="24"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                        </Border>
                        <Label Text="Перетащите файл .docx или нажмите для выбора"
                               FontSize="14.5"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource TextPrimary}" />
                        <Label Text="Поддерживается формат Microsoft Word (.docx)"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Карточка выбранного документа (активна после выбора файла) -->
                <Border x:Name="FileSelectedCard"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16, 14">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                BackgroundColor="{DynamicResource IconBoxBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="44"
                                HeightRequest="44"
                                VerticalOptions="Center">
                            <vctrl:IconView Icon="file"
                                            IconColor="BrandGreen"
                                            Size="20"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="FileNameLabel"
                                   Text="Документ не выбран"
                                   FontSize="14.5"
                                   FontAttributes="Bold"
                                   LineBreakMode="MiddleTruncation"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Label x:Name="FileInfoLabel"
                                   Text="Подойдёт файл Word (.docx)"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="2"
                                StyleClass="HoverCard"
                                StrokeThickness="1"
                                Stroke="{DynamicResource CardStroke}"
                                BackgroundColor="{DynamicResource CardHoverBg}"
                                StrokeShape="RoundRectangle 10"
                                Padding="12, 6"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickTapped" />
                            </Border.GestureRecognizers>
                            <Label x:Name="PickLabel"
                                   Text="Заменить"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Состояние: файл пока не выбран -->
                <Border x:Name="EmptyPanel"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="20, 24"
                        Margin="0, 4">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Center">
                            <vctrl:IconView Icon="shield"
                                            IconColor="BrandGreen"
                                            Size="26"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                        </Border>

                        <Label Text="Локальная проверка документа по ГОСТ"
                               FontSize="16.5"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource TextPrimary}" />

                        <Label Text="Проверка полей страницы, гарнитуры и размера шрифта, межстрочных интервалов, нумерации и обязательных разделов. Простые ошибки исправляются в один клик. Файл остаётся строго на устройстве."
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Результат проверки: список замечаний со скроллом -->
                <VerticalStackLayout x:Name="ResultPanel" IsVisible="False" Spacing="14">
                    <Button Text="Закрыть документ"
                            HorizontalOptions="End"
                            Clicked="OnCloseDocumentClicked" />
                    <Label x:Name="StatusLabel"
                           IsVisible="False"
                           FontSize="13"
                           FontAttributes="Bold"
                           LineBreakMode="WordWrap"
                           TextColor="{DynamicResource BrandGreen}" />

                    <!-- Заголовок замечаний со счётчиком и кнопкой «Принять все» -->
                    <!-- Весь заголовок со счётчиком виден ТОЛЬКО если HasIssues == true -->
                    <Grid IsVisible="{Binding HasIssues}"
                          ColumnDefinitions="*, Auto"
                          VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="Замечания к оформлению"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8, 2"
                                    VerticalOptions="Center">
                                <Label Text="{Binding IssueGroups.Count}"
                                       FontSize="12.5"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandGreen}"
                                       VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Кнопка «Принять все», видна только если HasFixableIssues == true -->
                        <Border Grid.Column="1"
                                IsVisible="{Binding HasFixableIssues}"
                                StyleClass="HoverGreen"
                                StrokeThickness="0"
                                BackgroundColor="{DynamicResource ActionBg}"
                                StrokeShape="RoundRectangle 10"
                                Padding="14, 7"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AcceptAllCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <vctrl:IconView Icon="sparkles"
                                                IconColor="White"
                                                Size="14"
                                                VerticalOptions="Center" />
                                <Label Text="Принять все"
                                       FontSize="12.5"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Список замечаний (сворачиваемые карточки) -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding IssueGroups}"
                                         Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="views:CheckGroupVm">
                                <Border BackgroundColor="{DynamicResource CardBg}"
                                        Stroke="{DynamicResource CardStroke}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="16, 14">
                                    <VerticalStackLayout Spacing="8">

                                        <!-- Строка 1: слева Title (bold), справа «N из M абзацев» -->
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding WhereText}"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource TextSecondary}"
                                                   VerticalOptions="Center"
                                                   HorizontalTextAlignment="End" />
                                        </Grid>

                                        <!-- Строка 2: одна строка «Сейчас → Будет» крупно (видна при HasDiff) -->
                                        <Border IsVisible="{Binding HasDiff}"
                                                BackgroundColor="{DynamicResource CardHoverBg}"
                                                Stroke="{DynamicResource CardStroke}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="12, 7">
                                            <Label Text="{Binding DiffText}"
                                                   FontSize="13.5"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}" />
                                        </Border>

                                        <!-- Строка 3: две строки Grid с FixAllHint в строке 1 и кнопками в строке 2 -->
                                        <Grid RowDefinitions="Auto, Auto"
                                              RowSpacing="4">

                                            <!-- Строка 1: подпись FixAllHint -->
                                            <Label Grid.Row="0"
                                                   Text="{Binding FixAllHint}"
                                                   FontSize="11.5"
                                                   TextColor="{DynamicResource TextSecondary}"
                                                   VerticalOptions="Center" />

                                            <!-- Строка 2: кнопки действий -->
                                            <HorizontalStackLayout Grid.Row="1"
                                                                   Spacing="6"
                                                                   HorizontalOptions="End"
                                                                   VerticalOptions="Center">

                                                <!-- Кнопка «Подробнее ▾» / «Свернуть ▴» -->
                                                <Border IsVisible="{Binding HasItems}"
                                                        StyleClass="HoverCard"
                                                        StrokeThickness="1"
                                                        Stroke="{DynamicResource CardStroke}"
                                                        BackgroundColor="Transparent"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="10, 5"
                                                        VerticalOptions="Center">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ToggleExpandCommand}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="{Binding ExpandButtonText}"
                                                           FontSize="11.5"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource BrandGreen}"
                                                           VerticalOptions="Center" />
                                                </Border>

                                                <!-- Кнопка «Отклонить» для карточки целиком -->
                                                <Border StyleClass="HoverCard"
                                                        StrokeThickness="1"
                                                        Stroke="{DynamicResource CardStroke}"
                                                        BackgroundColor="Transparent"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="12, 5"
                                                        VerticalOptions="Center">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding RejectGroupCommand}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="Отклонить"
                                                           FontSize="11.5"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource TextSecondary}"
                                                           VerticalOptions="Center" />
                                                </Border>

                                                <!-- Тег «Вручную» когда CanFix == false -->
                                                <Border IsVisible="{Binding CannotFix}"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{DynamicResource CardHoverBg}"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="12, 5"
                                                        VerticalOptions="Center">
                                                    <Label Text="Вручную"
                                                           FontSize="11.5"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource TextSecondary}"
                                                           VerticalOptions="Center" />
                                                </Border>

                                                <!-- Кнопка «Принять» когда CanFix == true -->
                                                <Border IsVisible="{Binding CanFix}"
                                                        StyleClass="HoverGreen"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{DynamicResource ActionBg}"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="14, 5"
                                                        VerticalOptions="Center">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding AcceptGroupCommand}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="Принять"
                                                           FontSize="11.5"
                                                           FontAttributes="Bold"
                                                           TextColor="#FFFFFF"
                                                           VerticalOptions="Center" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <!-- ==================== РАЗВЁРНУТАЯ ЧАСТЬ (СЕКЦИЯ ITEMS) ==================== -->
                                        <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                                             Spacing="8"
                                                             Margin="0, 6, 0, 0">

                                            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 2" />

                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}"
                                                                 Spacing="6">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="views:CheckItemVm">
                                                        <Border BackgroundColor="{DynamicResource CardHoverBg}"
                                                                Stroke="{DynamicResource CardStroke}"
                                                                StrokeThickness="1"
                                                                StrokeShape="RoundRectangle 10"
                                                                Padding="10, 8">
                                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">

                                                                <!-- Слева: Text (в кавычках) и под ним Actual → Expected -->
                                                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                                    <Label Text="{Binding DisplayText}"
                                                                           FontSize="12.5"
                                                                           TextColor="{DynamicResource TextPrimary}"
                                                                           LineBreakMode="TailTruncation" />
                                                                    <Label Text="{Binding DiffSubtext}"
                                                                           FontSize="11"
                                                                           TextColor="{DynamicResource TextSecondary}"
                                                                           LineBreakMode="TailTruncation" />
                                                                </VerticalStackLayout>

                                                                <!-- Справа: кнопки строки «Отклонить» и «Принять» -->
                                                                <HorizontalStackLayout Grid.Column="1"
                                                                                       Spacing="6"
                                                                                       VerticalOptions="Center">

                                                                    <Border StyleClass="HoverCard"
                                                                            StrokeThickness="1"
                                                                            Stroke="{DynamicResource CardStroke}"
                                                                            BackgroundColor="Transparent"
                                                                            StrokeShape="RoundRectangle 6"
                                                                            Padding="8, 4"
                                                                            VerticalOptions="Center">
                                                                        <Border.GestureRecognizers>
                                                                            <TapGestureRecognizer Command="{Binding RejectItemCommand}" />
                                                                        </Border.GestureRecognizers>
                                                                        <Label Text="Отклонить"
                                                                               FontSize="11"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{DynamicResource TextSecondary}"
                                                                               VerticalOptions="Center" />
                                                                    </Border>

                                                                    <Border IsVisible="{Binding CanFix}"
                                                                            StyleClass="HoverGreen"
                                                                            StrokeThickness="0"
                                                                            BackgroundColor="{DynamicResource ActionBg}"
                                                                            StrokeShape="RoundRectangle 6"
                                                                            Padding="10, 4"
                                                                            VerticalOptions="Center">
                                                                        <Border.GestureRecognizers>
                                                                            <TapGestureRecognizer Command="{Binding AcceptItemCommand}" />
                                                                        </Border.GestureRecognizers>
                                                                        <Label Text="Принять"
                                                                               FontSize="11"
                                                                               FontAttributes="Bold"
                                                                               TextColor="#FFFFFF"
                                                                               VerticalOptions="Center" />
                                                                    </Border>
                                                                </HorizontalStackLayout>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>

                                            <Label IsVisible="{Binding HasMoreText}"
                                                   Text="{Binding MoreText}"
                                                   FontSize="11.5"
                                                   FontAttributes="Italic"
                                                   TextColor="{DynamicResource TextSecondary}"
                                                   HorizontalOptions="Center"
                                                   Margin="0, 2, 0, 2" />

                                        </VerticalStackLayout>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <HorizontalStackLayout IsVisible="{Binding HasHiddenIssues}" Spacing="12">
                        <Label Text="{Binding HiddenIssuesText}"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />
                        <Button Text="Показать скрытые" Clicked="OnShowHiddenClicked" />
                    </HorizontalStackLayout>

                    <!-- Карточка Успеха (когда замечаний нет или все исправлены) -->
                    <Border IsVisible="{Binding NoIssues}"
                            BackgroundColor="{DynamicResource CardBg}"
                            Stroke="{DynamicResource CardStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="18, 16">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" VerticalOptions="Center">
                            <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    VerticalOptions="Center">
                                <vctrl:IconView Icon="shield"
                                                IconColor="BrandGreen"
                                                Size="22"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="По выбранным правилам замечаний нет"
                                       FontSize="15.5"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Требования вне выбранного набора проверьте вручную."
                                       FontSize="12.5"
                                       TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <ActivityIndicator x:Name="Loader"
                                   IsRunning="False"
                                   IsVisible="False"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Color="{DynamicResource BrandGreen}" />

                <!-- ==================== ПАНЕЛЬ ДЕЙСТВИЙ (ФУТЕР ВНУТРИ СКРОЛЛА) ==================== -->
                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 8, 0, 0" />

                <Grid x:Name="ActionBar"
                      ColumnDefinitions="*, *"
                      ColumnSpacing="10"
                      Padding="0, 4, 0, 10">

                    <Border x:Name="PrimaryButton"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            StyleClass="HoverGreen"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            Padding="12, 14"
                            Background="{DynamicResource BrandGreenGradient}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPrimaryTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="PrimaryLabel"
                               Text="Выбрать документ"
                               FontSize="15"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation"
                               TextColor="#FFFFFF"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Border x:Name="SaveButton"
                            Grid.Column="1"
                            IsVisible="False"
                            StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            Padding="12, 14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSaveCopyTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="Сохранить копию"
                               FontSize="14.5"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation"
                               TextColor="{DynamicResource TextPrimary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
