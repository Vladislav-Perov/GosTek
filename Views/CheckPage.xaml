<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Профессиональный интерфейс аудита оформления документов по ГОСТ
 СОДЕРЖИМОЕ: ContentPage, Dropzone, Summary Card, ChipBar, Accordions, AppTabBar, IconView
 ЗАВИСИМОСТИ: GosTek.Views.CheckPage, GosTek.Controls.ChipBar, GosTek.Views.AppTabBar, GosTek.Views.Controls.IconView
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             xmlns:controls="clr-namespace:GosTek.Controls"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.CheckPage"
             Title="Проверка"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="{OnPlatform Android='*', WinUI='220, *'}"
          RowDefinitions="{OnPlatform Android='Auto, *, Auto, Auto', WinUI='Auto, *, Auto, 0'}">

        <!-- ==================== ШАПКА ==================== -->
        <Grid Grid.Row="0"
              Grid.Column="{OnPlatform Android=0, WinUI=1}"
              Padding="20, 15, 20, 10"
              ColumnDefinitions="*"
              BackgroundColor="{DynamicResource PageBg}">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Проверка"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />
                <Label Text="Инспектор оформления документов по ГОСТ"
                       FontSize="13"
                       TextColor="{DynamicResource TextSecondary}" />
            </VerticalStackLayout>
        </Grid>

        <!-- ==================== ТЕЛО СТРАНИЦЫ ==================== -->
        <ScrollView Grid.Row="1"
                    Grid.Column="{OnPlatform Android=0, WinUI=1}"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout MaximumWidthRequest="700"
                                 HorizontalOptions="Fill"
                                 Padding="{OnPlatform Android='20, 6, 20, 80', WinUI='20, 6, 20, 24'}"
                                 Spacing="16">

                <!-- 1. Зона выбора файла (Dropzone) с пунктирной рамкой (когда файл ещё не выбран) -->
                <Border x:Name="DropzoneBorder"
                        StyleClass="HoverCard"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeDashArray="4,4"
                        StrokeThickness="1.8"
                        StrokeShape="RoundRectangle 20"
                        Padding="24, 28"
                        HorizontalOptions="Fill">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPickTapped" />
                        <DropGestureRecognizer Drop="OnDropFile" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                WidthRequest="54"
                                HeightRequest="54"
                                HorizontalOptions="Center">
                            <vctrl:IconView Icon="file"
                                            IconColor="BrandGreen"
                                            Size="26"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                        </Border>

                        <Label Text="Перетащите файл .docx или нажмите для выбора"
                               FontSize="15.5"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource TextPrimary}" />

                        <Label Text="Формат Microsoft Word (.docx) • Локальный аудит по ГОСТ"
                               FontSize="12.5"
                               HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 2. Карточка выбранного документа (активна после выбора файла) -->
                <Border x:Name="FileSelectedCard"
                        IsVisible="False"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16, 14">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.06" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                BackgroundColor="{DynamicResource IconBoxBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="44"
                                HeightRequest="44"
                                VerticalOptions="Center">
                            <vctrl:IconView Icon="file"
                                            IconColor="BrandGreen"
                                            Size="20"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="FileNameLabel"
                                   Text="Документ не выбран"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   LineBreakMode="MiddleTruncation"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Label x:Name="FileInfoLabel"
                                   Text="Поддерживается формат Word (.docx)"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="2"
                                StyleClass="HoverCard"
                                StrokeThickness="1"
                                Stroke="{DynamicResource CardStroke}"
                                BackgroundColor="{DynamicResource CardBg}"
                                StrokeShape="RoundRectangle 12"
                                Padding="14, 8"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickTapped" />
                            </Border.GestureRecognizers>
                            <Label x:Name="PickLabel"
                                   Text="Заменить"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. Правила проверки (чипы создаются из кода) -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Text="Правила оформления"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />

                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEditCurrentRuleTapped" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <vctrl:IconView Icon="pen"
                                            IconColor="BrandGreen"
                                            Size="14"
                                            VerticalOptions="Center" />
                            <Label x:Name="EditCurrentRuleLabel"
                                   Text="Настроить"
                                   FontSize="12.5"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource BrandGreen}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>

                    <controls:ChipBar x:Name="RuleChips" Margin="0, 2, 0, 2" />

                    <Label x:Name="RuleNote"
                           IsVisible="False"
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="{DynamicResource TextSecondary}"
                           Margin="2, 0" />
                </VerticalStackLayout>

                <!-- 4. Конструктор правил ГОСТ / Мои правила -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16, 14">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.06" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                            <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    VerticalOptions="Center">
                                <vctrl:IconView Icon="ruler"
                                                IconColor="BrandGreen"
                                                Size="18"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Пользовательские правила"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Настраивайте поля, шрифт и интервалы с визуальным сравнением"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <!-- Кнопка Создать с нуля -->
                            <Border Grid.Column="0"
                                    StyleClass="HoverCard"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CardStroke}"
                                    BackgroundColor="{DynamicResource CardBg}"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10, 9">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCreateNewRuleTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <vctrl:IconView Icon="plus"
                                                    IconColor="TextPrimary"
                                                    Size="14"
                                                    VerticalOptions="Center" />
                                    <Label Text="С нуля"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Кнопка Создать на основе -->
                            <Border Grid.Column="1"
                                    StyleClass="HoverCard"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CardStroke}"
                                    BackgroundColor="{DynamicResource CardBg}"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10, 9">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCreateBasedOnRuleTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <vctrl:IconView Icon="copy"
                                                    IconColor="TextPrimary"
                                                    Size="14"
                                                    VerticalOptions="Center" />
                                    <Label Text="На основе…"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Список сохраненных пользовательских правил -->
                        <VerticalStackLayout x:Name="CustomRulesHost" Spacing="8" />
                    </VerticalStackLayout>
                </Border>

                <!-- 5. Состояние: файл пока не выбран -->
                <Border x:Name="EmptyPanel"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="20, 24"
                        Margin="0, 4">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Center">
                            <vctrl:IconView Icon="shield"
                                            IconColor="BrandGreen"
                                            Size="26"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                        </Border>

                        <Label Text="Локальная проверка документа по ГОСТ"
                               FontSize="16.5"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource TextPrimary}" />

                        <Label Text="Проверка полей страницы, гарнитуры и размера шрифта, межстрочных интервалов, нумерации и обязательных разделов. Простые ошибки исправляются в один клик. Файл остаётся строго на устройстве."
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 6. Результат проверки -->
                <VerticalStackLayout x:Name="ResultPanel" IsVisible="False" Spacing="14">
                    <Label x:Name="StatusLabel"
                           IsVisible="False"
                           FontSize="13"
                           FontAttributes="Bold"
                           LineBreakMode="WordWrap"
                           TextColor="{DynamicResource BrandGreen}" />

                    <!-- Карточка итогов (Summary Card) профессионального инспектора -->
                    <Border x:Name="SummaryBox"
                            StrokeThickness="1.5"
                            Stroke="{DynamicResource CardStroke}"
                            StrokeShape="RoundRectangle 18"
                            Padding="18, 16">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.08" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" VerticalOptions="Center">
                            <Border x:Name="SummaryIconBox"
                                    BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    VerticalOptions="Center">
                                <vctrl:IconView x:Name="SummaryIconCtrl"
                                                Icon="shield"
                                                IconColor="BrandGreen"
                                                Size="24"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label x:Name="SummaryTitle"
                                       Text="Результаты проверки"
                                       FontSize="16.5"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label x:Name="SummarySubtitle"
                                       Text=""
                                       FontSize="12.5"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                                <Label x:Name="SummaryLabel" IsVisible="False" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Замечания (группируются в аккордеоны по важности) -->
                    <VerticalStackLayout x:Name="IssuesHost" Spacing="10" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="Loader"
                           Grid.Row="1"
                           Grid.Column="{OnPlatform Android=0, WinUI=1}"
                           IsRunning="False"
                           IsVisible="False"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{DynamicResource BrandGreen}" />

        <!-- ==================== ПАНЕЛЬ ДЕЙСТВИЙ (ФИКСИРОВАННЫЙ ФУТЕР) ==================== -->
        <VerticalStackLayout Grid.Row="2"
                             Grid.Column="{OnPlatform Android=0, WinUI=1}"
                             Spacing="0"
                             BackgroundColor="{DynamicResource PageBg}">
            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />

            <Grid x:Name="ActionBar"
                  ColumnDefinitions="*, *"
                  ColumnSpacing="10"
                  Padding="20, 12, 20, 14"
                  MaximumWidthRequest="700">

                <Border x:Name="PrimaryButton"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        StyleClass="HoverGreen"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        Padding="8, 15"
                        Background="{DynamicResource BrandGreenGradient}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0, 4" Radius="10" Opacity="0.18" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrimaryTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="PrimaryLabel"
                           Text="Выбрать документ"
                           FontSize="15.5"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"
                           TextColor="#FFFFFF"
                           HorizontalOptions="Center" />
                </Border>

                <Border x:Name="SaveButton"
                        Grid.Column="1"
                        IsVisible="False"
                        StyleClass="HoverCard"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="{DynamicResource CardStroke}"
                        BackgroundColor="{DynamicResource CardBg}"
                        Padding="8, 15">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0, 2" Radius="6" Opacity="0.06" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaveCopyTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Сохранить копию"
                           FontSize="15"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"
                           TextColor="{DynamicResource TextPrimary}"
                           HorizontalOptions="Center" />
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!-- ==================== ТАББАР (на Windows — левый rail, на Android — нижний) ==================== -->
        <views:AppTabBar x:Name="BottomTabs"
                         Grid.Row="{OnPlatform Android=3, WinUI=0}"
                         Grid.RowSpan="{OnPlatform Android=1, WinUI=4}"
                         Grid.Column="0"
                         ActiveTab="check" />

    </Grid>
</ContentPage>
