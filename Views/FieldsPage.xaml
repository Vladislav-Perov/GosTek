<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Интерфейс экрана заполнения шаблона с интерактивным предпросмотром А4 и шторкой экспорта
 СОДЕРЖИМОЕ: ContentPage, Grid, ScrollView, Border, ListRow, Path, ThemeToggle
 ЗАВИСИМОСТИ: GosTek.Views.FieldsPage, GosTek.Views.ListRow, GosTek.Views.ThemeToggle
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             x:Class="GosTek.Views.FieldsPage"
             Title="Шаблон"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False"
             SizeChanged="OnPageSizeChanged">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ==================== ШАПКА С ИНДИКАТОРОМ ШАГА ==================== -->
        <Grid Grid.Row="0"
              Padding="20, 14, 20, 10"
              ColumnDefinitions="Auto, *, Auto"
              ColumnSpacing="14"
              VerticalOptions="Center"
              BackgroundColor="{DynamicResource PageBg}">

            <!-- Кнопка «Назад» -->
            <Border Grid.Column="0"
                    StyleClass="HoverCard"
                    StrokeThickness="1"
                    Stroke="{DynamicResource CardStroke}"
                    BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 14"
                    WidthRequest="42"
                    HeightRequest="42"
                    Padding="0"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.06" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Path Data="M8,1 L2,8 L8,15"
                      Stroke="{DynamicResource TextPrimary}"
                      StrokeThickness="2.5"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      Aspect="Uniform"
                      WidthRequest="10"
                      HeightRequest="16"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Border>

            <!-- Название шаблона и индикатор шага -->
            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Border BackgroundColor="{DynamicResource IconBoxBg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="8, 2"
                            VerticalOptions="Center">
                        <Label Text="Шаг 1 из 2 • Заполнение"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource BrandGreen}"
                               VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>

                <Label x:Name="TitleLabel"
                       Text="Шаблон"
                       FontSize="20"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation"
                       TextColor="{DynamicResource TextPrimary}" />
            </VerticalStackLayout>

            <!-- Переключатель темы справа -->
            <views:ThemeToggle Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center" />
        </Grid>

        <!-- ==================== ТЕЛО ====================
             Столбец 0: форма ввода (+ предпросмотр под полями на узком экране)
             Столбец 1: предпросмотр справа (ширина 0, пока экран узкий) -->
        <Grid x:Name="Body" Grid.Row="1" ColumnDefinitions="*, 0">

            <!-- ====== ЛЕВАЯ КОЛОНКА: ВВОД ДАННЫХ ====== -->
            <ScrollView x:Name="FormScroll" Grid.Column="0" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Padding="20, 8, 20, 24"
                                     Spacing="16"
                                     MaximumWidthRequest="700"
                                     HorizontalOptions="Fill">

                    <!-- Карточка быстрого автозаполнения из профиля -->
                    <Border StyleClass="HoverCard"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16, 12">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.06" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFillTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="👤"
                                       FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Заполнить из профиля"
                                       FontSize="14.5"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Автоподстановка реквизитов и контактов"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12, 6"
                                    VerticalOptions="Center">
                                <Label Text="Вставить"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandGreen}"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Label x:Name="FillStatusLabel"
                           IsVisible="False"
                           FontSize="13"
                           FontAttributes="Bold"
                           LineBreakMode="WordWrap"
                           TextColor="{DynamicResource BrandGreen}"
                           Margin="4, -8, 4, 0" />

                    <!-- Заголовок секции полей -->
                    <Label Text="Данные документа"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextSecondary}"
                           Margin="2, 4, 2, -4" />

                    <!-- Контейнер для динамических полей шаблона -->
                    <VerticalStackLayout x:Name="FieldsHost" Spacing="14" />

                    <!-- Предпросмотр сразу под полями (виден только на узком экране смартфона) -->
                    <VerticalStackLayout x:Name="InlinePreview" Spacing="12" Margin="0, 16, 0, 0">
                        <Grid ColumnDefinitions="*, Auto" Margin="2, 0" VerticalOptions="Center">
                            <Label Text="Предпросмотр А4"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextSecondary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="📄 Лист Word"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextSecondary}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Border x:Name="InlinePanel"
                                BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                Padding="16, 20"
                                SizeChanged="OnPanelSizeChanged">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                            </Border.Shadow>
                            <Border x:Name="InlineSheet"
                                    BackgroundColor="White"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2"
                                    HorizontalOptions="Center">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0, 4" Radius="16" Opacity="0.22" />
                                </Border.Shadow>
                            </Border>
                        </Border>

                        <Label Text="Серые блоки — поля, которые ещё не заполнены в форме."
                               FontSize="12.5"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ====== ПРАВАЯ КОЛОНКА: ПРЕДПРОСМОТР А4 (широкий экран ПК / планшета) ====== -->
            <ScrollView x:Name="SideScroll"
                        Grid.Column="1"
                        IsVisible="False"
                        VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Padding="20, 8, 20, 24"
                                     Spacing="12"
                                     MaximumWidthRequest="700"
                                     HorizontalOptions="Fill">

                    <Grid ColumnDefinitions="*, Auto" Margin="2, 4, 2, 0" VerticalOptions="Center">
                        <Label Text="ПРЕДПРОСМОТР А4"
                               FontSize="12"
                               FontAttributes="Bold"
                               CharacterSpacing="0.8"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="📄 Лист Word"
                               FontSize="12"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>

                    <Border x:Name="SidePanel"
                            BackgroundColor="{DynamicResource CardBg}"
                            Stroke="{DynamicResource CardStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="16, 20"
                            SizeChanged="OnPanelSizeChanged">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                        </Border.Shadow>
                        <Border x:Name="SideSheet"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 2"
                                HorizontalOptions="Center">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0, 4" Radius="16" Opacity="0.22" />
                            </Border.Shadow>
                        </Border>
                    </Border>

                    <Label Text="Серые блоки — поля, которые ещё не заполнены в форме."
                           FontSize="12.5"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           TextColor="{DynamicResource TextSecondary}" />

                </VerticalStackLayout>
            </ScrollView>

            <!-- Разделительная линия между колонками на широком экране -->
            <BoxView x:Name="PaneDivider"
                     Grid.Column="1"
                     IsVisible="False"
                     WidthRequest="1"
                     HorizontalOptions="Start"
                     Color="{DynamicResource Divider}" />

        </Grid>

        <!-- ==================== ЗАКРЕПЛЕННАЯ ПАНЕЛЬ ДЕЙСТВИЯ ==================== -->
        <VerticalStackLayout Grid.Row="2" Spacing="0" BackgroundColor="{DynamicResource PageBg}">
            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />

            <Border StyleClass="HoverGreen"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    Padding="0, 16"
                    Margin="20, 12"
                    MaximumWidthRequest="700"
                    BackgroundColor="{DynamicResource BrandGreen}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0, 4" Radius="10" Opacity="0.18" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBuildTapped" />
                </Border.GestureRecognizers>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" VerticalOptions="Center">
                    <Label Text="✨" FontSize="17" VerticalOptions="Center" />
                    <Label Text="Собрать документ"
                           FontSize="16.5"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- ==================== МОДАЛЬНОЕ ОКНО (ШТОРКА) ЭКСПОРТА ==================== -->
        <Grid x:Name="ExportOverlay"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#99000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnExportCloseTapped" />
            </Grid.GestureRecognizers>

            <Border VerticalOptions="End"
                    MaximumWidthRequest="700"
                    BackgroundColor="{DynamicResource PageBg}"
                    Stroke="{DynamicResource CardStroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    Padding="20, 12, 20, 24">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0, -4" Radius="20" Opacity="0.2" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSheetTapped" />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="16">

                    <!-- Индикатор перетаскивания шторки -->
                    <BoxView WidthRequest="44"
                             HeightRequest="4"
                             CornerRadius="2"
                             Color="{DynamicResource CardStroke}"
                             HorizontalOptions="Center" />

                    <!-- Шапка модального окна -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Собрать документ"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Label Text="Выберите удобный формат для экспорта готового файла"
                                   FontSize="12.5"
                                   TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                StyleClass="HoverCard"
                                StrokeThickness="1"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnExportCloseTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="✕"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Поле ввода имени файла -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ИМЯ СОХРАНЯЕМОГО ФАЙЛА"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="0.8"
                               TextColor="{DynamicResource TextSecondary}" />

                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="14, 0"
                                HeightRequest="48">
                            <Entry x:Name="FileNameEntry"
                                   Placeholder="Имя файла без расширения"
                                   PlaceholderColor="{DynamicResource TextSecondary}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="Transparent"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Варианты экспорта через унифицированные карточки ListRow -->
                    <VerticalStackLayout Spacing="10">
                        <views:ListRow Icon="📝"
                                       Title="Документ Word (.docx)"
                                       Subtitle="Полностью редактируемый файл по ГОСТ"
                                       Tapped="OnExportDocxTapped" />

                        <views:ListRow Icon="📕"
                                       Title="Документ PDF (.pdf)"
                                       Subtitle="Готов к печати, нативная векторная генерация"
                                       Tapped="OnExportPdfTapped" />

                        <views:ListRow Icon="📤"
                                       Title="Поделиться"
                                       Subtitle="Отправить в мессенджер, на почту или в облако"
                                       Tapped="OnExportShareTapped" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
