<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             x:Class="GosTek.Views.ProfilePage"
             Title="Профиль"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False">


    <Grid RowDefinitions="Auto, *, Auto, Auto">

        <!-- ==================== ШАПКА ==================== -->
        <Grid Grid.Row="0" Padding="20, 15, 20, 10">
            <Label Text="Мой профиль"
                   FontSize="26"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{DynamicResource TextPrimary}" />

            <views:ThemeToggle HorizontalOptions="End" VerticalOptions="Center" />
        </Grid>

        <!-- ==================== КОНТЕНТ ==================== -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20, 6, 20, 20"
                                 Spacing="16"
                                 MaximumWidthRequest="700"
                                 HorizontalOptions="Fill">

                <!-- Прогресс заполнения -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="ProgressTitle"
                               Text="Заполнено на 0%"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" />
                        <ProgressBar x:Name="FillProgress"
                                     Progress="0"
                                     ProgressColor="{DynamicResource AccentGreen}"
                                     BackgroundColor="{DynamicResource CardStroke}"
                                     HeightRequest="8" />
                        <Label x:Name="ProgressHint"
                               FontSize="13"
                               TextColor="{DynamicResource TextSecondary}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Пояснение про хранение -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" Padding="4,0">
                    <Label Grid.Column="0" Text="🔒" FontSize="18" VerticalOptions="Start" />
                    <Label Grid.Column="1"
                           Text="Данные хранятся только на этом устройстве в зашифрованном виде."
                           FontSize="13"
                           TextColor="{DynamicResource TextSecondary}"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Поля создаются из кода (ProfilePage.xaml.cs, таблица Specs) -->
                <VerticalStackLayout x:Name="FieldsHost" Spacing="16" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== КНОПКА «СОХРАНИТЬ» ==================== -->
        <VerticalStackLayout Grid.Row="2" Spacing="0">
            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />
            <Border StyleClass="HoverGreen"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    Padding="0,16"
                    Margin="20,12"
                    MaximumWidthRequest="700">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.15" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSaveTapped" />
                </Border.GestureRecognizers>
                <Label Text="Сохранить"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#064E3B"
                       HorizontalOptions="Center" />
            </Border>
        </VerticalStackLayout>

        <!-- ==================== ТАББАР ==================== -->
        <views:AppTabBar x:Name="BottomTabs" Grid.Row="3" ActiveTab="profile" />

    </Grid>
</ContentPage>