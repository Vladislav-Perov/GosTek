<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Интерфейс экрана редактирования реквизитов организации и гражданина
 СОДЕРЖИМОЕ: ContentPage, ScrollView, Border, Entry, Label, AppTabBar, ThemeToggle
 ЗАВИСИМОСТИ: GosTek.Views.ProfilePage, GosTek.Views.AppTabBar, GosTek.Views.ThemeToggle
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             x:Class="GosTek.Views.ProfilePage"
             Title="Профиль"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto, Auto">

        <!-- ==================== ШАПКА ==================== -->
        <Grid Grid.Row="0"
              Padding="20, 15, 20, 10"
              ColumnDefinitions="*, Auto"
              ColumnSpacing="12"
              BackgroundColor="{DynamicResource PageBg}">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Мой профиль"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />
                <Label Text="Реквизиты для автозаполнения документов"
                       FontSize="13"
                       TextColor="{DynamicResource TextSecondary}" />
            </VerticalStackLayout>

            <views:ThemeToggle Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" />
        </Grid>

        <!-- ==================== КОНТЕНТ ==================== -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20, 6, 20, 20"
                                 Spacing="16"
                                 MaximumWidthRequest="700"
                                 HorizontalOptions="Fill">

                <!-- Карточка прогресса заполненности профиля -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="18, 16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label x:Name="ProgressTitle"
                                       Text="Заполнено на 0%"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label x:Name="ProgressHint"
                                       FontSize="12.5"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <!-- Сегментный бейдж процента -->
                            <Border Grid.Column="1"
                                    BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12, 6"
                                    VerticalOptions="Center">
                                <Label x:Name="ProgressBadgeLabel"
                                       Text="0%"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandGreen}"
                                       HorizontalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Полоса прогресса -->
                        <ProgressBar x:Name="FillProgress"
                                     Progress="0"
                                     ProgressColor="{DynamicResource BrandGreen}"
                                     BackgroundColor="{DynamicResource CardStroke}"
                                     HeightRequest="6" />
                    </VerticalStackLayout>
                </Border>

                <!-- Быстрое заполнение: акцентная промо-карточка сканера паспорта -->
                <Border StyleClass="HoverCard"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource BrandGreen}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 18"
                        Padding="16, 14"
                        AutomationProperties.Name="Заполнить по фото паспорта">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0, 3" Radius="8" Opacity="0.08" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPassportScanTapped" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                BackgroundColor="{DynamicResource IconBoxBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="44"
                                HeightRequest="44"
                                VerticalOptions="Center">
                            <Label Text="📷" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Заполнить по фото паспорта"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Label Text="Быстрое автосчитывание ФИО и данных документа"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextSecondary}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <Border Grid.Column="2"
                                BackgroundColor="{DynamicResource IconBoxBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="12, 6"
                                VerticalOptions="Center">
                            <Label Text="Сканировать"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource BrandGreen}"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Пояснение про безопасное локальное хранилище данных -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14, 10">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="🛡️" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Данные хранятся исключительно локально на этом устройстве в зашифрованном виде."
                               FontSize="12"
                               TextColor="{DynamicResource TextSecondary}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Заголовок секции полей -->
                <Label Text="Поля профиля"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextSecondary}"
                       Margin="2, 4, 2, -6" />

                <!-- Поля создаются динамически из кода (ProfilePage.xaml.cs) -->
                <VerticalStackLayout x:Name="FieldsHost" Spacing="14" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== ПАНЕЛЬ ДЕЙСТВИЯ (КНОПКА «СОХРАНИТЬ») ==================== -->
        <VerticalStackLayout Grid.Row="2" Spacing="0" BackgroundColor="{DynamicResource PageBg}">
            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />

            <!-- Появляется только когда в полях есть ошибки -->
            <Grid x:Name="IgnoreRow"
                  IsVisible="False"
                  ColumnDefinitions="Auto, *"
                  ColumnSpacing="8"
                  Padding="20, 10, 20, 0"
                  MaximumWidthRequest="700">
                <CheckBox x:Name="IgnoreCheck"
                          Color="{DynamicResource BrandGreen}"
                          VerticalOptions="Center"
                          CheckedChanged="OnIgnoreChanged" />
                <Label Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       Text="Игнорировать ошибки и сохранить как есть"
                       TextColor="{DynamicResource TextSecondary}"
                       LineBreakMode="WordWrap">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnIgnoreLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Border StyleClass="HoverGreen"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    Padding="0, 16"
                    Margin="20, 12"
                    MaximumWidthRequest="700"
                    BackgroundColor="{DynamicResource BrandGreen}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0, 4" Radius="10" Opacity="0.18" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSaveTapped" />
                </Border.GestureRecognizers>
                <Label x:Name="SaveLabel"
                       Text="Сохранить"
                       FontSize="16.5"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalOptions="Center" />
            </Border>
        </VerticalStackLayout>

        <!-- ==================== ТАББАР ==================== -->
        <views:AppTabBar x:Name="BottomTabs" Grid.Row="3" ActiveTab="profile" />

    </Grid>
</ContentPage>
