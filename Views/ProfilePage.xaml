<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Интерфейс экрана редактирования реквизитов организации и гражданина с поддержкой кастомных полей
 СОДЕРЖИМОЕ: ContentPage, ScrollView, Border, Entry, Label, AppTabBar, IconView
 ЗАВИСИМОСТИ: GosTek.Views.ProfilePage, GosTek.Views.AppTabBar, GosTek.Views.Controls.IconView
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.ProfilePage"
             Title="Профиль"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="{OnPlatform Android='*', WinUI='220, *'}"
          RowDefinitions="{OnPlatform Android='Auto, *, Auto, Auto', WinUI='Auto, *, Auto, 0'}">

        <!-- ==================== ШАПКА ==================== -->
        <Grid Grid.Row="0"
              Grid.Column="{OnPlatform Android=0, WinUI=1}"
              Padding="20, 15, 20, 10"
              ColumnDefinitions="*"
              BackgroundColor="{DynamicResource PageBg}">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Мой профиль"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />
                <Label Text="Реквизиты для автозаполнения документов"
                       FontSize="13"
                       TextColor="{DynamicResource TextSecondary}" />
            </VerticalStackLayout>
        </Grid>

        <!-- ==================== КОНТЕНТ ==================== -->
        <ScrollView Grid.Row="1"
                    Grid.Column="{OnPlatform Android=0, WinUI=1}"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="{OnPlatform Android='20, 6, 20, 80', WinUI='20, 6, 20, 24'}"
                                 Spacing="16"
                                 MaximumWidthRequest="700"
                                 HorizontalOptions="Fill">

                <!-- Карточка прогресса заполненности профиля -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="18, 16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label x:Name="ProgressTitle"
                                       Text="Заполнено на 0%"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label x:Name="ProgressHint"
                                       FontSize="12.5"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <!-- Сегментный бейдж процента с контрастной рамкой -->
                            <Border Grid.Column="1"
                                    BackgroundColor="{DynamicResource IconBoxBg}"
                                    Stroke="{DynamicResource BrandGreen}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12, 6"
                                    VerticalOptions="Center">
                                <Label x:Name="ProgressBadgeLabel"
                                       Text="0%"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandGreen}"
                                       HorizontalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Полоса прогресса -->
                        <ProgressBar x:Name="FillProgress"
                                     Progress="0"
                                     ProgressColor="{DynamicResource BrandGreen}"
                                     BackgroundColor="{DynamicResource CardStroke}"
                                     HeightRequest="6" />
                    </VerticalStackLayout>
                </Border>

                <!-- Быстрое заполнение: акцентная промо-карточка сканера паспорта -->
                <Border StyleClass="HoverCard"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource BrandGreen}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 18"
                        Padding="16, 14"
                        AutomationProperties.Name="Заполнить по фото паспорта">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0, 3" Radius="8" Opacity="0.08" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPassportScanTapped" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                BackgroundColor="{DynamicResource IconBoxBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="44"
                                HeightRequest="44"
                                VerticalOptions="Center">
                            <vctrl:IconView Icon="camera"
                                            IconColor="BrandGreen"
                                            Size="20"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Заполнить по фото паспорта"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Label Text="Быстрое автосчитывание ФИО и данных документа"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextSecondary}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <Border Grid.Column="2"
                                BackgroundColor="{DynamicResource IconBoxBg}"
                                Stroke="{DynamicResource BrandGreen}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12, 6"
                                VerticalOptions="Center">
                            <Label Text="Сканировать"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource BrandGreen}"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Пояснение про безопасное локальное хранилище данных -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14, 10">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <vctrl:IconView Icon="shield"
                                        IconColor="BrandGreen"
                                        Size="18"
                                        VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Данные хранятся исключительно локально на этом устройстве в зашифрованном виде."
                               FontSize="12"
                               TextColor="{DynamicResource TextSecondary}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Заголовок секции полей -->
                <Label Text="Базовые реквизиты"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextSecondary}"
                       Margin="2, 4, 2, -6" />

                <!-- Поля создаются динамически из кода (ProfilePage.xaml.cs) -->
                <VerticalStackLayout x:Name="FieldsHost" Spacing="14" />

                <!-- Разделитель -->
                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 8, 0, 4" />

                <!-- Секция дополнительных пользовательских полей (CustomFields) -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto" Margin="2, 0" VerticalOptions="Center">
                        <Label Text="Дополнительные поля"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout x:Name="CustomFieldsHost" Spacing="12" />

                    <!-- Кнопка «+ Добавить свое поле» -->
                    <Border StyleClass="HoverCard"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            StrokeShape="RoundRectangle 16"
                            Padding="16, 14"
                            HorizontalOptions="Fill">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddCustomFieldTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" VerticalOptions="Center">
                            <vctrl:IconView Icon="plus"
                                            IconColor="BrandGreen"
                                            Size="16"
                                            VerticalOptions="Center" />
                            <Label Text="Добавить своё поле"
                                   FontSize="14.5"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource BrandGreen}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== ПАНЕЛЬ ДЕЙСТВИЯ (КНОПКА «СОХРАНИТЬ») ==================== -->
        <VerticalStackLayout Grid.Row="2"
                             Grid.Column="{OnPlatform Android=0, WinUI=1}"
                             Spacing="0"
                             BackgroundColor="{DynamicResource PageBg}">
            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />

            <!-- Появляется только когда в полях есть ошибки -->
            <Grid x:Name="IgnoreRow"
                  IsVisible="False"
                  ColumnDefinitions="Auto, *"
                  ColumnSpacing="8"
                  Padding="20, 10, 20, 0"
                  MaximumWidthRequest="700">
                <CheckBox x:Name="IgnoreCheck"
                          Color="{DynamicResource BrandGreen}"
                          VerticalOptions="Center"
                          CheckedChanged="OnIgnoreChanged" />
                <Label Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       Text="Игнорировать ошибки и сохранить как есть"
                       TextColor="{DynamicResource TextSecondary}"
                       LineBreakMode="WordWrap">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnIgnoreLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Border StyleClass="HoverGreen"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    Padding="0, 16"
                    Margin="20, 12"
                    MaximumWidthRequest="700"
                    Background="{DynamicResource BrandGreenGradient}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0, 4" Radius="10" Opacity="0.18" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSaveTapped" />
                </Border.GestureRecognizers>
                <Label x:Name="SaveLabel"
                       Text="Сохранить"
                       FontSize="16.5"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalOptions="Center" />
            </Border>
        </VerticalStackLayout>

        <!-- ==================== ТАББАР (на Windows — левый rail, на Android — нижний) ==================== -->
        <views:AppTabBar x:Name="BottomTabs"
                         Grid.Row="{OnPlatform Android=3, WinUI=0}"
                         Grid.RowSpan="{OnPlatform Android=1, WinUI=4}"
                         Grid.Column="0"
                         ActiveTab="profile" />

    </Grid>
</ContentPage>
