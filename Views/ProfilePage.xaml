<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Интерфейс экрана редактирования реквизитов организации и гражданина с поддержкой кастомных полей
 СОДЕРЖИМОЕ: ContentPage, ScrollView, Border, Entry, Label, AppTabBar, IconView
 ЗАВИСИМОСТИ: GosTek.Views.ProfilePage, GosTek.Views.AppTabBar, GosTek.Views.Controls.IconView
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.ProfilePage"
             Title="Профиль"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*">

        <!-- ==================== КОНТЕНТ ==================== -->
        <ScrollView Grid.Row="0"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="{OnPlatform Android='20, 16, 20, 80', WinUI='20, 20, 20, 24'}"
                                 Spacing="16"
                                 MaximumWidthRequest="950"
                                 HorizontalOptions="Fill">

                <!-- ШАПКА -->
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Мой профиль"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Label Text="Реквизиты для автозаполнения документов"
                           FontSize="13"
                           TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- Карточка прогресса заполненности профиля -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        HorizontalOptions="Fill"
                        Padding="18, 16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label x:Name="ProgressTitle"
                                       Text="Заполнено на 0%"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label x:Name="ProgressHint"
                                       FontSize="12.5"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <!-- Сегментный бейдж процента с контрастной рамкой -->
                            <Border Grid.Column="1"
                                    BackgroundColor="{DynamicResource IconBoxBg}"
                                    Stroke="{DynamicResource BrandGreen}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12, 6"
                                    VerticalOptions="Center">
                                <Label x:Name="ProgressBadgeLabel"
                                       Text="0%"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandGreen}"
                                       HorizontalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Полоса прогресса -->
                        <ProgressBar x:Name="FillProgress"
                                     Progress="0"
                                     ProgressColor="{DynamicResource BrandGreen}"
                                     BackgroundColor="{DynamicResource CardStroke}"
                                     HeightRequest="6" />
                    </VerticalStackLayout>
                </Border>

                <!-- Пояснение про безопасное локальное хранилище данных -->
                <Border BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        HorizontalOptions="Fill"
                        Padding="16, 14">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <vctrl:IconView Icon="shield"
                                        IconColor="BrandGreen"
                                        Size="18"
                                        VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Данные хранятся исключительно локально на этом устройстве в зашифрованном виде."
                               FontSize="12"
                               TextColor="{DynamicResource TextSecondary}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Заголовок секции полей -->
                <Label Text="Базовые реквизиты"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextSecondary}"
                       Margin="2, 4, 2, -6" />

                <!-- Поля создаются динамически из кода (ProfilePage.xaml.cs) -->
                <VerticalStackLayout x:Name="FieldsHost" Spacing="16" HorizontalOptions="Fill" />

                <!-- Разделитель -->
                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 8, 0, 4" HorizontalOptions="Fill" />

                <!-- Секция дополнительных пользовательских полей (CustomFields) -->
                <VerticalStackLayout Spacing="12" HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="*, Auto" Margin="2, 0" VerticalOptions="Center">
                        <Label Text="Дополнительные поля"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout x:Name="CustomFieldsHost" Spacing="12" HorizontalOptions="Fill" />

                    <!-- Кнопка «+ Добавить свое поле» -->
                    <Border StyleClass="HoverCard"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            StrokeShape="RoundRectangle 16"
                            Padding="16, 14"
                            HorizontalOptions="Fill">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddCustomFieldTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" VerticalOptions="Center">
                            <vctrl:IconView Icon="plus"
                                            IconColor="BrandGreen"
                                            Size="16"
                                            VerticalOptions="Center" />
                            <Label Text="Добавить своё поле"
                                   FontSize="14.5"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource BrandGreen}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ==================== ПАНЕЛЬ ДЕЙСТВИЯ (КНОПКА «СОХРАНИТЬ») ==================== -->
                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 8, 0, 0" HorizontalOptions="Fill" />

                <!-- Появляется только когда в полях есть ошибки -->
                <Grid x:Name="IgnoreRow"
                      IsVisible="False"
                      ColumnDefinitions="Auto, *"
                      ColumnSpacing="8"
                      HorizontalOptions="Fill"
                      Padding="0, 8, 0, 0">
                    <CheckBox x:Name="IgnoreCheck"
                              Color="{DynamicResource BrandGreen}"
                              VerticalOptions="Center"
                              CheckedChanged="OnIgnoreChanged" />
                    <Label Grid.Column="1"
                           VerticalOptions="Center"
                           FontSize="13"
                           Text="Игнорировать ошибки и сохранить как есть"
                           TextColor="{DynamicResource TextSecondary}"
                           LineBreakMode="WordWrap">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnIgnoreLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Border StyleClass="HoverGreen"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        Padding="8, 15"
                        Margin="0, 4, 0, 10"
                        HorizontalOptions="Fill"
                        Background="{DynamicResource BrandGreenGradient}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0, 4" Radius="10" Opacity="0.18" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaveTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="SaveLabel"
                           Text="Сохранить"
                           FontSize="15.5"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           HorizontalOptions="Center" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
