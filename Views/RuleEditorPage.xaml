<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Интерфейс конструктора правил ГОСТ с двухстраничным живым предпросмотром А4 и масштабированием (Zoom)
 СОДЕРЖИМОЕ: ContentPage, Split View (55* / 45*), Настройки ГОСТ, Двухстраничный Live Preview А4 с зумом
 ЗАВИСИМОСТИ: GosTek.Views.RuleEditorPage, GosTek.Models.RuleSet, GosTek.Services.CustomRulesService, GosTek.Views.Controls.IconView
 ==============================================================================
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GosTek.Views"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.RuleEditorPage"
              x:DataType="views:RuleEditorPage"
             Title="Конструктор правил ГОСТ"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Shell.TabBarIsVisible="False">

    <Grid>
        <!-- ОСНОВНОЙ КОНТЕНТ СТРАНИЦЫ -->
        <Grid RowDefinitions="Auto, *, Auto">

            <!-- ==================== ШАПКА ==================== -->
            <VerticalStackLayout Grid.Row="0" Spacing="0">
                <Grid Padding="{OnPlatform Android='20, 24, 20, 8', WinUI='20, 15, 20, 10'}"
                      ColumnDefinitions="Auto, *"
                      ColumnSpacing="14">

                    <Border Grid.Column="0"
                            StyleClass="HoverCard"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,6"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Border.GestureRecognizers>
                        <Path Data="M8,1 L2,8 L8,15"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="2.5"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              Aspect="Uniform"
                              WidthRequest="10"
                              HeightRequest="16"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>

                    <Label x:Name="PageTitleLabel"
                           Grid.Column="1"
                           Text="Настройка профиля ГОСТ"
                           FontSize="22"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center"
                           TextColor="{DynamicResource TextPrimary}" />
                </Grid>

                <!-- Переключатель вкладок только для мобильных устройств (Android) -->
                <Border x:Name="AndroidModeSwitcher"
                        IsVisible="{OnPlatform Android=True, Default=False, WinUI=False}"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="4"
                        Margin="16, 0, 16, 8"
                        HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="6">
                        <Border x:Name="TabSettingsBtn"
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource BrandGreen}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="10, 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTabSettingsTapped" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" VerticalOptions="Center">
                                <vctrl:IconView x:Name="TabSettingsIcon" Icon="settings" IconColor="White" Size="15" VerticalOptions="Center" />
                                <Label x:Name="TabSettingsLabel"
                                       Text="Параметры"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="TabPreviewBtn"
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="10, 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTabPreviewTapped" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" VerticalOptions="Center">
                                <vctrl:IconView x:Name="TabPreviewIcon" Icon="eye" IconColor="TextSecondary" Size="15" VerticalOptions="Center" />
                                <Label x:Name="TabPreviewLabel"
                                       Text="Лист А4"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- ==================== ОБЛАСТЬ РЕДАКТИРОВАНИЯ И ЖИВОГО ПРЕДПРОСМОТРА ==================== -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="{OnPlatform WinUI='55*, 45*', Default='*'}"
                  RowDefinitions="*"
                  ColumnSpacing="16"
                  Padding="16, 4, 16, 12">

                <!-- ЛЕВАЯ КОЛОНКА (55%): НАСТРОЙКИ СО СКРОЛЛОМ -->
                <ScrollView x:Name="SettingsScrollView"
                            Grid.Column="0"
                            Grid.Row="0"
                            VerticalScrollBarVisibility="Never"
                            IsVisible="{OnPlatform WinUI=True, Default={Binding IsSettingsVisible}}">
                    <VerticalStackLayout MaximumWidthRequest="720"
                                         HorizontalOptions="Fill"
                                         Padding="4, 0, 4, 20"
                                         Spacing="16">

                        <!-- ==================== СЕКЦИЯ 1: ОСНОВНАЯ ИНФОРМАЦИЯ ==================== -->
                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="16">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0"
                                           Text="Основная информация"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="1"
                                            x:Name="CloneButton"
                                            StyleClass="HoverCard"
                                            StrokeThickness="1"
                                            Stroke="{DynamicResource CardStroke}"
                                            BackgroundColor="{DynamicResource CardHoverBg}"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10, 6"
                                            VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCreateBasedOnThisTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Создать на основе этого"
                                               FontSize="11.5"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource BrandGreen}"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Название правила *" StyleClass="FieldLabel" />
                                    <Border StyleClass="FieldBox">
                                        <Entry x:Name="TitleEntry"
                                               StyleClass="FieldEntry"
                                               Placeholder="например, Основной ГОСТ (кафедра)"
                                               TextChanged="OnSettingChanged" />
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ==================== СЕКЦИЯ 2: ПОЛЯ СТРАНИЦЫ ==================== -->
                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="16">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Поля страницы (см)" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <Label Text="Левое поле, см" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="LeftMarginEntry"
                                                   StyleClass="FieldEntry"
                                                   Keyboard="Numeric"
                                                   Text="3.0"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <Label Text="Правое поле, см" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="RightMarginEntry"
                                                   StyleClass="FieldEntry"
                                                   Keyboard="Numeric"
                                                   Text="1.0"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <Label Text="Верхнее поле, см" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="TopMarginEntry"
                                                   StyleClass="FieldEntry"
                                                   Keyboard="Numeric"
                                                   Text="2.0"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <Label Text="Нижнее поле, см" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="BottomMarginEntry"
                                                   StyleClass="FieldEntry"
                                                   Keyboard="Numeric"
                                                   Text="2.0"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ==================== СЕКЦИЯ 3: ТЕКСТ И АБЗАЦЫ ==================== -->
                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="16">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Шрифт и форматирование текста" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <Label Text="Шрифт" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="FontPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <Label Text="Размер шрифта, pt" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="FontSizeEntry"
                                                   StyleClass="FieldEntry"
                                                   Keyboard="Numeric"
                                                   Text="14"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <Label Text="Межстрочный интервал" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="SpacingPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <Label Text="Красная строка, см" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="FirstLineIndentEntry"
                                                   StyleClass="FieldEntry"
                                                   Keyboard="Numeric"
                                                   Text="1.25"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                        <Label Text="Выравнивание основного текста" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="AlignPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0,4" />

                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Нумерация страниц" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="Требовать наличие номеров страниц в колонтитулах" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Switch x:Name="RequirePageNumbersSwitch"
                                            Grid.Column="1"
                                            IsToggled="True"
                                            VerticalOptions="Center"
                                            Toggled="OnSettingChanged" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ==================== СЕКЦИЯ 4: ОФОРМЛЕНИЕ ТАБЛИЦ ==================== -->
                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="16">
                            <VerticalStackLayout Spacing="14">
                                <!-- Шапка карточки таблиц -->
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="📊" FontSize="18" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Оформление таблиц" FontSize="15.5" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="Шрифт, кегль и межстрочный интервал в ячейках таблиц" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Switch x:Name="FormatTablesSwitch"
                                            Grid.Column="2"
                                            IsToggled="True"
                                            VerticalOptions="Center"
                                            Toggled="OnSettingChanged" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />

                                <Label Text="Параметры текста в таблицах:" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource BrandGreen}" />

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <Label Text="Шрифт таблицы" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="TableFontPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <Label Text="Размер шрифта, pt" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="TableFontSizeEntry"
                                                   Text="12.0"
                                                   Keyboard="Numeric"
                                                   HeightRequest="50"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <Label Text="Межстрочный интервал" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="TableLineSpacingPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" Text="Без красной строки" StyleClass="FieldLabel" VerticalOptions="Center" />
                                        <Switch x:Name="TableNoIndentSwitch"
                                                Grid.Column="1"
                                                IsToggled="True"
                                                VerticalOptions="Center"
                                                Toggled="OnSettingChanged" />
                                    </Grid>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 4" />

                                <Label Text="Подпись таблицы:" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource BrandGreen}" />

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <Label Text="Выравнивание подписи" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="TableCaptionAlignPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <Label Text="Межстрочный интервал" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="TableCaptionLineSpacingPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <Label Text="Отступ сверху, pt" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="TableCaptionSpacingBeforeEntry"
                                                   Text="6.0"
                                                   Keyboard="Numeric"
                                                   HeightRequest="50"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <Label Text="Отступ снизу, pt" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="TableCaptionSpacingAfterEntry"
                                                   Text="3.0"
                                                   Keyboard="Numeric"
                                                   HeightRequest="50"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" Text="Без красной строки" StyleClass="FieldLabel" VerticalOptions="Center" />
                                        <Switch x:Name="TableCaptionNoIndentSwitch"
                                                Grid.Column="1"
                                                IsToggled="True"
                                                VerticalOptions="Center"
                                                Toggled="OnSettingChanged" />
                                    </Grid>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ==================== СЕКЦИЯ 5: РИСУНКИ И ПОДПИСИ ==================== -->
                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="16">
                            <VerticalStackLayout Spacing="14">
                                <!-- Шапка карточки рисунков -->
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="🖼️" FontSize="18" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Рисунки и подписи" FontSize="15.5" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="Выравнивание иллюстраций, подписи и отступы ГОСТ" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Switch x:Name="FormatFiguresSwitch"
                                            Grid.Column="2"
                                            IsToggled="True"
                                            VerticalOptions="Center"
                                            Toggled="OnSettingChanged" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />

                                <Label Text="Настройка рисунков:" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource BrandGreen}" />

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <Label Text="Выравнивание рисунка" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="FigureAlignPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" Text="Без красной строки" StyleClass="FieldLabel" VerticalOptions="Center" />
                                        <Switch x:Name="FigureNoIndentSwitch"
                                                Grid.Column="1"
                                                IsToggled="True"
                                                VerticalOptions="Center"
                                                Toggled="OnSettingChanged" />
                                    </Grid>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <Label Text="Отступ сверху, pt" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="FigureSpacingBeforeEntry"
                                                   StyleClass="FieldEntry"
                                                   Keyboard="Numeric"
                                                   Text="12.0"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <Label Text="Отступ снизу, pt" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="FigureSpacingAfterEntry"
                                                   StyleClass="FieldEntry"
                                                   Keyboard="Numeric"
                                                   Text="12.0"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <Label Text="Настройка подписей («Рисунок 1 — ...»):" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource BrandGreen}" Margin="0,4,0,0" />

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <Label Text="Выравнивание подписи" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="CaptionAlignPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <Label Text="Межстрочный интервал" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="CaptionLineSpacingPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <Label Text="Отступ сверху, pt" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="CaptionSpacingBeforeEntry"
                                                   StyleClass="FieldEntry"
                                                   Keyboard="Numeric"
                                                   Text="0.0"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <Label Text="Отступ снизу, pt" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="CaptionSpacingAfterEntry"
                                                   StyleClass="FieldEntry"
                                                   Keyboard="Numeric"
                                                   Text="0.0"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ==================== СЕКЦИЯ 6: ЛИСТИНГИ КОДА ==================== -->
                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="16">
                            <VerticalStackLayout Spacing="14">
                                <!-- Шапка карточки кода -->
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="💻" FontSize="18" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Листинги программного кода" FontSize="15.5" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="Моноширинный шрифт, кегль, компактный интервал" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Switch x:Name="FormatCodeSwitch"
                                            Grid.Column="2"
                                            IsToggled="True"
                                            VerticalOptions="Center"
                                            Toggled="OnSettingChanged" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />

                                <Label Text="Настройка блоков кода:" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource BrandGreen}" />

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <Label Text="Моноширинный шрифт" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="CodeFontPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <Label Text="Размер шрифта, pt" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="CodeFontSizeEntry"
                                                   StyleClass="FieldEntry"
                                                   Keyboard="Numeric"
                                                   Text="12.0"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <Label Text="Межстрочный интервал" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="CodeLineSpacingPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" Text="Без красной строки" StyleClass="FieldLabel" VerticalOptions="Center" />
                                        <Switch x:Name="CodeNoIndentSwitch"
                                                Grid.Column="1"
                                                IsToggled="True"
                                                VerticalOptions="Center"
                                                Toggled="OnSettingChanged" />
                                    </Grid>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ==================== СЕКЦИЯ 7: ЗАГОЛОВКИ ==================== -->
                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="{DynamicResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="16">
                            <VerticalStackLayout Spacing="14">
                                <!-- Шапка карточки заголовков -->
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="📑" FontSize="18" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Оформление заголовков" FontSize="15.5" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="Шрифт, кегль, выравнивание, отступы и правила разделов" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Switch x:Name="FormatHeadingsSwitch"
                                            Grid.Column="2"
                                            IsToggled="True"
                                            VerticalOptions="Center"
                                            Toggled="OnSettingChanged" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />

                                <Label Text="Параметры шрифта и расположения:" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource BrandGreen}" />

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <Label Text="Шрифт заголовка" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="HeadingFontPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <Label Text="Размер шрифта, pt" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="HeadingFontSizeEntry"
                                                   Text="16.0"
                                                   Keyboard="Numeric"
                                                   HeightRequest="50"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <Label Text="Выравнивание" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="HeadingAlignPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <Label Text="Межстрочный интервал" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Picker x:Name="HeadingLineSpacingPicker"
                                                    HeightRequest="50"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    SelectedIndexChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                                        <Label Text="Отступ сверху, pt" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="HeadingSpacingBeforeEntry"
                                                   Text="12.0"
                                                   Keyboard="Numeric"
                                                   HeightRequest="50"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                                        <Label Text="Отступ снизу, pt" StyleClass="FieldLabel" />
                                        <Border StyleClass="FieldBox">
                                            <Entry x:Name="HeadingSpacingAfterEntry"
                                                   Text="6.0"
                                                   Keyboard="Numeric"
                                                   HeightRequest="50"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   TextChanged="OnSettingChanged" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0, 4" />

                                <Label Text="Правила оформления заголовков ГОСТ:" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource BrandGreen}" />

                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Требовать полужирный шрифт (Bold)" StyleClass="FieldLabel" VerticalOptions="Center" />
                                    <Switch x:Name="HeadingRequireBoldSwitch"
                                            Grid.Column="1"
                                            IsToggled="True"
                                            VerticalOptions="Center"
                                            Toggled="OnSettingChanged" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Без абзацного отступа (по левому краю / центру)" StyleClass="FieldLabel" VerticalOptions="Center" />
                                    <Switch x:Name="HeadingRequireNoIndentSwitch"
                                            Grid.Column="1"
                                            IsToggled="True"
                                            VerticalOptions="Center"
                                            Toggled="OnSettingChanged" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Удалять точку в конце заголовка" StyleClass="FieldLabel" VerticalOptions="Center" />
                                    <Switch x:Name="HeadingRemoveTrailingDotSwitch"
                                            Grid.Column="1"
                                            IsToggled="True"
                                            VerticalOptions="Center"
                                            Toggled="OnSettingChanged" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- ПРАВАЯ КОЛОНКА (45%): ЕДИНЫЙ ЖИВОЙ ПРЕДПРОСМОТР А4 С ЗУМОМ -->
                <Border x:Name="PreviewPanelBorder"
                        Grid.Column="{OnPlatform WinUI=1, Default=0}"
                        Grid.Row="0"
                        IsVisible="{OnPlatform WinUI=True, Default={Binding IsPreviewVisible}}"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="14"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0, 4" Radius="12" Opacity="0.08" />
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto, Auto, *">
                        <!-- 1. Заголовок панели предпросмотра с кнопками зума -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center" Margin="2, 0, 2, 8">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource IconBoxBg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    VerticalOptions="Center">
                                <vctrl:IconView Icon="eye"
                                                IconColor="BrandGreen"
                                                Size="18"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Интерактивный документ А4"
                                       FontSize="14.5"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Единый лист: текст, таблица, рисунок, листинг кода"
                                       FontSize="11.5"
                                       TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>

                            <!-- Кнопки зума -->
                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                <Border StyleClass="HoverCard"
                                        StrokeThickness="1"
                                        Stroke="{DynamicResource CardStroke}"
                                        BackgroundColor="{DynamicResource CardHoverBg}"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8, 6"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnZoomOutTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="🔍−" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                                </Border>

                                <Border BackgroundColor="{DynamicResource IconBoxBg}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="6, 4"
                                        VerticalOptions="Center">
                                    <Label x:Name="ZoomPercentLabel"
                                           Text="100%"
                                           FontSize="11.5"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource BrandGreen}"
                                           VerticalOptions="Center" />
                                </Border>

                                <Border StyleClass="HoverCard"
                                        StrokeThickness="1"
                                        Stroke="{DynamicResource CardStroke}"
                                        BackgroundColor="{DynamicResource CardHoverBg}"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8, 6"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnZoomInTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="🔍+" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- 2. Бейдж параметров -->
                        <Border Grid.Row="1"
                                BackgroundColor="{DynamicResource IconBoxBg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="10, 6"
                                Margin="0, 0, 0, 10"
                                HorizontalOptions="Fill">
                            <Label x:Name="AfterBadgeLabel"
                                   Text="ГОСТ: поля 3/1/2/2 см, 14pt, инт. 1.5"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{DynamicResource BrandGreen}" />
                        </Border>

                        <!-- 3. Двунаправленный скролл для листа предпросмотра (Orientation Both для Windows, Vertical для мобильных) -->
                        <ScrollView Grid.Row="2"
                                    VerticalScrollBarVisibility="Default"
                                    HorizontalScrollBarVisibility="{OnPlatform WinUI=Default, Default=Never}"
                                    Orientation="{OnPlatform WinUI=Both, Default=Vertical}">
                            <VerticalStackLayout HorizontalOptions="Center" Padding="8, 6, 8, 24">
                                <VerticalStackLayout.GestureRecognizers>
                                    <PinchGestureRecognizer PinchUpdated="OnPreviewPinch" />
                                </VerticalStackLayout.GestureRecognizers>

                                <!-- ЕДИНЫЙ ВИРТУАЛЬНЫЙ ЛИСТ ДОКУМЕНТА ГОСТ -->
                                <Border x:Name="DocumentSheetBorder"
                                        BackgroundColor="White"
                                        StrokeThickness="1.5"
                                        Stroke="{DynamicResource BrandGreen}"
                                        StrokeShape="RoundRectangle 4"
                                        HorizontalOptions="Center">
                                    <Border.Shadow>
                                        <Shadow Brush="#10B981" Offset="0, 4" Radius="16" Opacity="0.22" />
                                    </Border.Shadow>
                                </Border>

                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>
                </Border>

            </Grid>

            <!-- ==================== ПАНЕЛЬ ДЕЙСТВИЙ ВНИЗУ ==================== -->
            <VerticalStackLayout Grid.Row="2" Spacing="0">
                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />

                <Grid x:Name="ActionBarGrid"
                      ColumnDefinitions="Auto, *"
                      ColumnSpacing="12"
                      Padding="{OnPlatform Android='20, 12, 20, 24', WinUI='20, 12, 20, 16'}"
                      MaximumWidthRequest="720">

                    <!-- Кнопка Удалить (видна только для пользовательских правил) -->
                    <Border x:Name="DeleteButton"
                            Grid.Column="0"
                            IsVisible="False"
                            StyleClass="HoverCard"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            Stroke="{DynamicResource CardStroke}"
                            BackgroundColor="{DynamicResource CardBg}"
                            Padding="16, 14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDeleteTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                            <vctrl:IconView Icon="trash"
                                            IconColor="BrandGreen"
                                            Size="16"
                                            VerticalOptions="Center" />
                            <Label Text="Удалить"
                                   FontSize="14.5"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextSecondary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Кнопка Сохранить -->
                    <Border x:Name="SaveButton"
                            Grid.Column="1"
                            StyleClass="HoverGreen"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            Padding="12,14"
                            Background="{DynamicResource BrandGreenGradient}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSaveTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <vctrl:IconView Icon="save"
                                            IconColor="White"
                                            Size="16"
                                            VerticalOptions="Center" />
                            <Label Text="Сохранить правило"
                                   FontSize="15.5"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
