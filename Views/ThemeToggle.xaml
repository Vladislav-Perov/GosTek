<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GosTek.Views.ThemeToggle">

    <Border StyleClass="HoverCard"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="10,5">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>

        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Label x:Name="ThemeIcon"
                   Text="🌙"
                   FontSize="16"
                   VerticalOptions="Center" />

            <Border WidthRequest="40"
                    HeightRequest="22"
                    BackgroundColor="{DynamicResource ToggleTrackBg}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 11"
                    VerticalOptions="Center">
                <Border x:Name="ToggleThumb"
                        WidthRequest="16"
                        HeightRequest="16"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Margin="3,0,0,0" />
            </Border>
        </HorizontalStackLayout>
    </Border>
</ContentView>
