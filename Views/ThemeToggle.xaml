<?xml version="1.0" encoding="utf-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Интерфейс переключателя светлой и тёмной темы интерфейса с векторной иконкой
 СОДЕРЖИМОЕ: ContentView, Border, AbsoluteLayout, IconView
 ЗАВИСИМОСТИ: GosTek.Views.ThemeToggle, GosTek.Views.Controls.IconView
 ==============================================================================
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vctrl="clr-namespace:GosTek.Views.Controls"
             x:Class="GosTek.Views.ThemeToggle">

    <Border StyleClass="HoverCard"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="10,5">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>

        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <!-- Векторная иконка Солнце / Луна через IconView -->
            <vctrl:IconView x:Name="ThemeIcon"
                            Icon="moon"
                            Size="16"
                            IconColor="TextPrimary"
                            VerticalOptions="Center" />

            <!-- Трек переключателя 40x22 на базе AbsoluteLayout -->
            <Border WidthRequest="40"
                    HeightRequest="22"
                    BackgroundColor="{DynamicResource ToggleTrackBg}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 11"
                    VerticalOptions="Center">
                <AbsoluteLayout WidthRequest="40" HeightRequest="22">
                    <Border x:Name="ToggleThumb"
                            AbsoluteLayout.LayoutBounds="3, 3, 16, 16"
                            AbsoluteLayout.LayoutFlags="None"
                            WidthRequest="16"
                            HeightRequest="16"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8" />
                </AbsoluteLayout>
            </Border>
        </HorizontalStackLayout>
    </Border>
</ContentView>
