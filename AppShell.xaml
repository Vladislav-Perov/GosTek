<?xml version="1.0" encoding="UTF-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Корневая визуальная оболочка приложения (Shell) с навигацией
 СОДЕРЖИМОЕ: Shell, TabBar, Tab, ShellContent
 ЗАВИСИМОСТИ: Views/MainPage.xaml, Views/TemplatesPage.xaml, Views/CheckPage.xaml, Views/ProfilePage.xaml
 ==============================================================================
-->
<Shell x:Class="GosTek.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:GosTek.Views"
       Title="GosTek"
       FlyoutBehavior="Disabled"
       Shell.TabBarIsVisible="False"
       Shell.BackgroundColor="{DynamicResource PageBg}"
       Shell.ForegroundColor="{DynamicResource TextPrimary}"
       Shell.TitleColor="{DynamicResource TextPrimary}"
       Shell.UnselectedColor="{DynamicResource TextSecondary}"
       BackgroundColor="{DynamicResource PageBg}">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Templates"
        ContentTemplate="{DataTemplate views:TemplatesPage}"
        Route="TemplatesPage" />
    <ShellContent
        Title="Scan"
        ContentTemplate="{DataTemplate views:ScanPage}"
        Route="ScanPage" />
    <ShellContent
        Title="Check"
        ContentTemplate="{DataTemplate views:CheckPage}"
        Route="CheckPage" />
    <ShellContent
        Title="Profile"
        ContentTemplate="{DataTemplate views:ProfilePage}"
        Route="ProfilePage" />
</Shell>
