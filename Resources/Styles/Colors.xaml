<?xml version="1.0" encoding="UTF-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Палитра цветов и градиентов приложения (светлая и тёмная)
 СОДЕРЖИМОЕ: Color resources, LinearGradientBrush, RadialGradientBrush
 ЗАВИСИМОСТИ: Microsoft.Maui.Controls
 ==============================================================================
-->
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#14634F</Color>
    <Color x:Key="SecondaryDarkText">#69D6B6</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#14634F</Color>
    <Color x:Key="PreviewInk">#374151</Color>
    <Color x:Key="OffBlack">#121B1C</Color>

    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Базовые fallback-значения динамической палитры темы (ThemeService) -->
    <Color x:Key="PageBg">#F4F7F5</Color>
    <Color x:Key="CardBg">#FFFFFF</Color>
    <Color x:Key="CardHoverBg">#E8F0EC</Color>
    <Color x:Key="CardStroke">#D5E0DB</Color>
    <Color x:Key="TextPrimary">#172823</Color>
    <Color x:Key="TextSecondary">#49605A</Color>
    <Color x:Key="BrandGreen">#14634F</Color>
    <Color x:Key="AccentGreen">#14634F</Color>
    <Color x:Key="ActionBg">#14634F</Color>
    <Color x:Key="Divider">#D5E0DB</Color>
    <Color x:Key="IconBoxBg">#DCEFE7</Color>
    <Color x:Key="TabBarBg">#FFFFFF</Color>
    <Color x:Key="TabActiveBg">#DCEFE7</Color>
    <Color x:Key="ToggleTrackBg">#C5D5CF</Color>
    <Color x:Key="BadColor">#B42318</Color>
    <Color x:Key="BadSoftBg">#FBE5E2</Color>
    <Color x:Key="WarnColor">#805003</Color>
    <Color x:Key="WarnSoftBg">#FCEFD6</Color>

    <!-- Базовые градиенты дизайн-системы -->
    <LinearGradientBrush x:Key="BrandGreenGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14634F" Offset="0.0" />
        <GradientStop Color="#17664F" Offset="1.0" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="MainPageBackgroundBrush" Center="0.5,0.4" Radius="0.9">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="#F4F7F5" Offset="1.0" />
    </RadialGradientBrush>

</ResourceDictionary>
