<?xml version="1.0" encoding="UTF-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Палитра цветов и градиентов приложения (Slate Dark и тёплая светлая)
 СОДЕРЖИМОЕ: Color resources, LinearGradientBrush, RadialGradientBrush
 ЗАВИСИМОСТИ: Microsoft.Maui.Controls
 ==============================================================================
-->
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Базовые fallback-значения динамической палитры темы (ThemeService) -->
    <Color x:Key="PageBg">#F6F4EE</Color>
    <Color x:Key="CardBg">#FFFFFF</Color>
    <Color x:Key="CardHoverBg">#EFEBE0</Color>
    <Color x:Key="CardStroke">#E2DED2</Color>
    <Color x:Key="TextPrimary">#16213A</Color>
    <Color x:Key="TextSecondary">#5A6479</Color>
    <Color x:Key="BrandGreen">#0D6B57</Color>
    <Color x:Key="AccentGreen">#0D6B57</Color>
    <Color x:Key="Divider">#E2DED2</Color>
    <Color x:Key="IconBoxBg">#DCEFE9</Color>
    <Color x:Key="TabBarBg">#FFFFFF</Color>
    <Color x:Key="TabActiveBg">#DCEFE9</Color>
    <Color x:Key="ToggleTrackBg">#D6D1C3</Color>
    <Color x:Key="BadColor">#B42318</Color>
    <Color x:Key="BadSoftBg">#FBE5E2</Color>
    <Color x:Key="WarnColor">#9A5B00</Color>
    <Color x:Key="WarnSoftBg">#FCEFD6</Color>

    <!-- Базовые градиенты дизайн-системы -->
    <LinearGradientBrush x:Key="BrandGreenGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D6B57" Offset="0.0" />
        <GradientStop Color="#14B8A6" Offset="1.0" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="MainPageBackgroundBrush" Center="0.5,0.4" Radius="0.9">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="#F6F4EE" Offset="1.0" />
    </RadialGradientBrush>

</ResourceDictionary>
