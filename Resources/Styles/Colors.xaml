<?xml version="1.0" encoding="UTF-8" ?>
<!--
 ==============================================================================
 НАЗНАЧЕНИЕ: Палитра цветов и градиентов приложения (светлая и тёмная)
 СОДЕРЖИМОЕ: Color resources, LinearGradientBrush, RadialGradientBrush
 ЗАВИСИМОСТИ: Microsoft.Maui.Controls
 ==============================================================================
-->
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#203C62</Color>
    <Color x:Key="SecondaryDarkText">#BACBD9</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#203C62</Color>
    <Color x:Key="PreviewInk">#374151</Color>
    <Color x:Key="OffBlack">#161F2C</Color>

    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Базовые fallback-значения динамической палитры темы (ThemeService) -->
    <Color x:Key="PageBg">#F2F5F8</Color>
    <Color x:Key="CardBg">#FFFFFF</Color>
    <Color x:Key="CardHoverBg">#EDF1F4</Color>
    <Color x:Key="CardStroke">#D6E0EA</Color>
    <Color x:Key="TextPrimary">#17283B</Color>
    <Color x:Key="TextSecondary">#485B70</Color>
    <Color x:Key="BrandGreen">#203C62</Color>
    <Color x:Key="AccentGreen">#203C62</Color>
    <Color x:Key="ActionBg">#203C62</Color>
    <Color x:Key="ActionHoverBg">#2B4B72</Color>
    <Color x:Key="Divider">#D6E0EA</Color>
    <Color x:Key="IconBoxBg">#E4EBF4</Color>
    <Color x:Key="TabBarBg">#FFFFFF</Color>
    <Color x:Key="TabActiveBg">#E4EBF4</Color>
    <SolidColorBrush x:Key="RailSelectedBrush" Color="#203C62" />
    <SolidColorBrush x:Key="RailHoverBrush" Color="#EDF1F4" />
    <SolidColorBrush x:Key="RailIdleBrush" Color="Transparent" />
    <Color x:Key="RailSelectedText">#FFFFFF</Color>
    <Color x:Key="ToggleTrackBg">#C4CFDA</Color>
    <Color x:Key="BadColor">#B42318</Color>
    <Color x:Key="BadSoftBg">#FBE5E2</Color>
    <Color x:Key="WarnColor">#805003</Color>
    <Color x:Key="WarnSoftBg">#FCEFD6</Color>

</ResourceDictionary>
